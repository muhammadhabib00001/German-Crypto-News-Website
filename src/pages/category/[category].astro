---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AdPlacement from '../../components/AdPlacement.astro';
import CryptoMarketsHub from '../../components/CryptoMarketsHub.astro';
import { CATEGORIES, CATEGORY_LIST } from '../../data/categories';

export async function getStaticPaths() {
  const rawArticles = await getCollection('news');
  const articles = rawArticles.map(a => ({
    ...a,
    slug: a.id.replace(/\.md$/, '')
  }));
  
  return CATEGORY_LIST.map((cat) => {
    const categoryArticles = articles
      .filter((a) => a.data.category.toLowerCase() === cat.slug.toLowerCase())
      .sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());

    return {
      params: { category: cat.slug },
      props: { cat, articles: categoryArticles, allArticles: articles }
    };
  });
}

const { cat, articles, allArticles } = Astro.props;

const fallbackArticles = articles.length > 0 ? articles : allArticles.slice(0, 4);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://cryptopulse.news"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": cat.name,
      "item": `https://cryptopulse.news/category/${cat.slug}`
    }
  ]
};
---

<BaseLayout
  title={cat.metaTitle}
  description={cat.description}
  canonicalUrl={`https://cryptopulse.news/category/${cat.slug}`}
  structuredData={breadcrumbSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    
    <!-- Category Header -->
    <header class="mb-10 pb-8 border-b border-slate-200">
      <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
        <a href="/" class="hover:text-amber-600">Home</a>
        <span>/</span>
        <span class="text-slate-900 font-medium">{cat.name}</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight flex items-center gap-3">
            <span class={`w-3 h-8 rounded-full ${cat.textColor.replace('text-', 'bg-')}`}></span>
            <span>{cat.name} Intelligence & News</span>
          </h1>
          <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-3xl leading-relaxed">
            {cat.description}
          </p>
        </div>

        <div class="shrink-0 flex items-center gap-2 bg-white border border-slate-200 px-4 py-2 rounded-xl text-xs text-slate-700 shadow-xs">
          <span class="font-bold text-amber-600">{articles.length}</span>
          <span>Verified Articles</span>
        </div>
      </div>
    </header>

    <AdPlacement format="leaderboard" />

    {cat.slug === 'crypto-markets' && <CryptoMarketsHub />}

    <!-- Articles Grid Section Header -->
    <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-6 mt-4">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
        <span>📰</span>
        <span>{cat.slug === 'crypto-markets' ? 'In-Depth Market Reports & Detailed Analysis' : `${cat.name} Articles`}</span>
      </h2>
      <span class="text-xs font-semibold text-slate-500">Chronological Reports</span>
    </div>

    <!-- Articles Grid -->
    {articles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map((art: any) => (
          <ArticleCard article={art} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-white border border-slate-200 rounded-2xl p-8 shadow-xs">
        <h3 class="text-base font-bold text-slate-900 mb-2">Expanding Real-Time Coverage</h3>
        <p class="text-slate-600 text-xs sm:text-sm max-w-md mx-auto mb-6">
          Our editorial desk is actively preparing fresh research and breaking market updates for {cat.name}. Explore top market stories below:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
          {fallbackArticles.map((art: any) => (
            <ArticleCard article={art} />
          ))}
        </div>
      </div>
    )}

  </div>
</BaseLayout>