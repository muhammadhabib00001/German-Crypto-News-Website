---
import { UPCOMING_TOKENS } from '../../data/upcomingTokens';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return UPCOMING_TOKENS.map((token) => ({
    params: { slug: token.id },
    props: { token }
  }));
}

const { token } = Astro.props;

const tokenSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `${token.name} ($${token.symbol})`,
  "description": token.shortDescription,
  "image": token.logo,
  "offers": {
    "@type": "Offer",
    "price": token.presalePrice?.replace('€', '').trim() || token.targetListingPrice?.replace('€', '').trim() || '0',
    "priceCurrency": "EUR",
    "availability": "https://schema.org/PreOrder"
  }
};

const stageGerman = {
  'Upcoming Presale': 'Kommender Presale',
  'Active Presale': 'Aktiver Presale',
  'Upcoming DEX Launch': 'Kommender DEX-Launch',
  'Upcoming CEX Launch': 'Kommender CEX-Launch',
  'Airdrop / Testnet': 'Airdrop & Testnet'
};
---

<BaseLayout
  title={`${token.name} ($${token.symbol}) - Token-Launch & Tokenomics | newskrypt`}
  description={token.shortDescription}
  canonicalUrl={`https://cryptopulse.news/token-launches/${token.id}`}
  structuredData={tokenSchema}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-14">
    
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 flex-wrap">
      <a href="/" class="hover:text-amber-600 transition-colors">Startseite</a>
      <span>/</span>
      <a href="/token-launches" class="hover:text-amber-600 transition-colors">Kommende Token-Launches</a>
      <span>/</span>
      <span class="text-black font-bold">{token.name} (${token.symbol})</span>
    </nav>

    <!-- Top Project Profile Header Card -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-10 mb-10 shadow-xs">
      <div class="flex flex-col sm:flex-row gap-6 items-start justify-between">
        
        <div class="flex items-start gap-4 sm:gap-6">
          <img
            src={token.logo}
            alt={token.name}
            class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl object-cover border-2 border-slate-200 shadow-md shrink-0"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1639762681485-074b7f938ba0?w=160&auto=format&fit=crop&q=80';"
          />
          <div>
            <div class="flex flex-wrap items-center gap-2.5 mb-1.5">
              <h1 class="text-2xl sm:text-4xl font-black text-black">{token.name}</h1>
              <span class="text-sm font-mono font-bold text-amber-700 bg-amber-500/10 border border-amber-500/20 px-2.5 py-0.5 rounded-lg">
                ${token.symbol}
              </span>
            </div>

            <div class="flex flex-wrap items-center gap-2 text-xs text-slate-600 mb-3">
              <span class="font-semibold text-black flex items-center gap-1">
                <span>{token.chainIcon}</span>
                <span>{token.blockchain} Blockchain</span>
              </span>
              <span>•</span>
              <span class="font-medium text-amber-700">{token.categoryLabel}</span>
              <span>•</span>
              <span class={`font-bold px-2 py-0.5 rounded-md border text-[11px] ${token.badgeColor}`}>
                {stageGerman[token.stage] || token.stage}
              </span>
            </div>

            <p class="text-slate-700 text-sm leading-relaxed max-w-2xl font-normal">
              {token.shortDescription}
            </p>
          </div>
        </div>

        <!-- Official Links Box -->
        <div class="flex flex-wrap sm:flex-col gap-2 shrink-0 w-full sm:w-auto">
          {token.links.website && (
            <a
              href={token.links.website}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 bg-black hover:bg-slate-800 text-white font-bold text-xs rounded-xl text-center shadow-xs transition-colors inline-flex items-center justify-center gap-1.5"
            >
              <span>Offizielle Website</span>
              <span>↗</span>
            </a>
          )}
          {token.links.twitter && (
            <a
              href={token.links.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-black font-semibold text-xs rounded-xl text-center border border-slate-200 transition-colors inline-flex items-center justify-center gap-1.5"
            >
              <span>Twitter / 𝕏</span>
            </a>
          )}
          {token.links.telegram && (
            <a
              href={token.links.telegram}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-black font-semibold text-xs rounded-xl text-center border border-slate-200 transition-colors inline-flex items-center justify-center gap-1.5"
            >
              <span>Telegram-Kanal</span>
            </a>
          )}
        </div>

      </div>

      <!-- Presale Metrics Row -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8 pt-8 border-t border-slate-100">
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/80">
          <span class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Startdatum</span>
          <span class="text-base font-bold text-black">{token.launchDateDisplay}</span>
        </div>
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/80">
          <span class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Preisentwicklung</span>
          <span class="text-base font-bold text-black">
            {token.presalePrice ? `${token.presalePrice} → ${token.targetListingPrice || 'TBA'}` : token.targetListingPrice || 'TBA'}
          </span>
        </div>
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/80">
          <span class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Hard Cap</span>
          <span class="text-base font-bold text-black">{token.hardCap || 'Fair Launch'}</span>
        </div>
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/80">
          <span class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Gesamtmenge</span>
          <span class="text-base font-bold text-black">{token.totalTokens}</span>
        </div>
      </div>
    </div>

    <!-- Overview & Security Audits Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-10">
      
      <!-- Left Column: Detailed Overview & Key Features (8 Cols) -->
      <div class="md:col-span-8 space-y-8">
        
        <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-xs">
          <h2 class="text-lg font-bold text-black mb-4">Projekt-Übersicht &amp; Architektur</h2>
          <p class="text-sm text-black leading-relaxed mb-6">
            {token.fullOverview}
          </p>

          <h3 class="text-xs uppercase font-bold text-slate-500 tracking-wider mb-3">Wichtige technische Merkmale &amp; Nutzen</h3>
          <ul class="space-y-2.5">
            {token.keyFeatures.map((feat) => (
              <li class="flex items-start gap-2.5 text-xs sm:text-sm text-black">
                <span class="text-amber-600 font-bold shrink-0">✓</span>
                <span>{feat}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Tokenomics Breakdown Section -->
        <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-xs">
          <h2 class="text-lg font-bold text-black mb-4">Tokenomics &amp; Token-Verteilung</h2>
          <p class="text-xs text-slate-600 mb-6">
            Geprüfte Verteilungsstruktur für ${token.symbol}. Transparente Zuteilungen sorgen für nachhaltige Ökosystem-Anreize.
          </p>

          <div class="space-y-3">
            <div>
              <div class="flex justify-between text-xs font-semibold text-black mb-1">
                <span>Öffentlicher Presale / Community</span>
                <span class="font-bold">{token.tokenomics.presale}%</span>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                <div class="bg-amber-500 h-2 rounded-full" style={`width: ${token.tokenomics.presale}%;`}></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-semibold text-black mb-1">
                <span>DEX/CEX Startliquidität</span>
                <span class="font-bold">{token.tokenomics.liquidity}%</span>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                <div class="bg-blue-500 h-2 rounded-full" style={`width: ${token.tokenomics.liquidity}%;`}></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-semibold text-black mb-1">
                <span>Staking-Prämien &amp; Anreize</span>
                <span class="font-bold">{token.tokenomics.stakingRewards}%</span>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                <div class="bg-emerald-500 h-2 rounded-full" style={`width: ${token.tokenomics.stakingRewards}%;`}></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-semibold text-black mb-1">
                <span>Ökosystem &amp; Entwicklung</span>
                <span class="font-bold">{token.tokenomics.ecosystem}%</span>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                <div class="bg-purple-500 h-2 rounded-full" style={`width: ${token.tokenomics.ecosystem}%;`}></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-semibold text-black mb-1">
                <span>Gründerteam &amp; Berater</span>
                <span class="font-bold">{token.tokenomics.team}%</span>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                <div class="bg-slate-400 h-2 rounded-full" style={`width: ${token.tokenomics.team}%;`}></div>
              </div>
            </div>
          </div>
        </section>

      </div>

      <!-- Right Column: Audit Status & Risk Disclosures (4 Cols) -->
      <div class="md:col-span-4 space-y-6">
        
        <!-- Audit Box -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs">
          <h3 class="text-sm font-bold text-black mb-4 flex items-center gap-2">
            <span>🛡️</span>
            <span>Sicherheits-Audit &amp; KYC</span>
          </h3>

          <div class="space-y-3 text-xs">
            <div class="flex items-center justify-between pb-2 border-b border-slate-100">
              <span class="text-slate-500 font-medium">Prüfunternehmen</span>
              <span class="font-bold text-black">{token.securityAudit.auditor}</span>
            </div>

            <div class="flex items-center justify-between pb-2 border-b border-slate-100">
              <span class="text-slate-500 font-medium">Sicherheits-Score</span>
              <span class="font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                {token.securityAudit.score}
              </span>
            </div>

            <div class="flex items-center justify-between pb-2 border-b border-slate-100">
              <span class="text-slate-500 font-medium">Team KYC verifiziert</span>
              <span class="font-bold text-black">
                {token.securityAudit.kycVerified ? '✓ Verifiziert' : 'Ausstehend'}
              </span>
            </div>

            <div class="flex items-center justify-between">
              <span class="text-slate-500 font-medium">Audit-Status</span>
              <span class="font-bold text-emerald-600">{token.securityAudit.status}</span>
            </div>
          </div>
        </div>

        <!-- Risk Level Card -->
        <div class="bg-slate-900 text-white rounded-2xl p-6 shadow-xs">
          <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 block mb-1">Einschätzung</span>
          <h4 class="text-lg font-black mb-2 flex items-center gap-2">
            <span>Risikostufe:</span>
            <span class="text-amber-400">{token.riskRating}</span>
          </h4>
          <p class="text-xs text-slate-300 leading-relaxed">
            Bitte beachten Sie, dass Presales und neue Tokens einer hohen Volatilität unterliegen. Führen Sie eigene Recherchen durch ("DYOR").
          </p>
        </div>

      </div>

    </div>

  </div>
</BaseLayout>
