---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('news');
  const authors = await getCollection('authors');
  
  const authorMap = new Map();
  authors.forEach(a => {
    const key = a.id.replace('.json', '');
    authorMap.set(key, a.data);
  });

  return articles.map((article, index) => {
    const slug = article.id.replace(/\.md$/, '');
    const authorData = authorMap.get(article.data.author) || {
      name: "CryptoPulse Editorial Team",
      role: "Financial News Desk",
      avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&auto=format&fit=crop&q=80",
      bio: "Covering crypto markets, policy, and blockchain developments.",
      social: {}
    };

    const related = articles
      .filter(a => a.id !== article.id && (a.data.category === article.data.category || a.data.tags.some(t => article.data.tags.includes(t))))
      .slice(0, 4)
      .map(a => ({
        ...a,
        slug: a.id.replace(/\.md$/, '')
      }));

    const prevArticle = index > 0 ? {
      ...articles[index - 1],
      slug: articles[index - 1].id.replace(/\.md$/, '')
    } : undefined;

    const nextArticle = index < articles.length - 1 ? {
      ...articles[index + 1],
      slug: articles[index + 1].id.replace(/\.md$/, '')
    } : undefined;

    return {
      params: { slug },
      props: {
        article: {
          ...article,
          slug
        },
        authorData,
        relatedArticles: related,
        prevArticle,
        nextArticle
      }
    };
  });
}

const { article, authorData, relatedArticles, prevArticle, nextArticle } = Astro.props;
const { Content, headings } = await render(article);
---

<ArticleLayout
  article={article}
  authorData={authorData}
  relatedArticles={relatedArticles}
  prevArticle={prevArticle}
  nextArticle={nextArticle}
  headings={headings}
>
  <Content />
</ArticleLayout>