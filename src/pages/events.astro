---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdPlacement from '../components/AdPlacement.astro';
import { CRYPTO_EVENTS } from '../data/events';

const featuredEvents = CRYPTO_EVENTS.filter(e => e.featured);
const allEvents = CRYPTO_EVENTS;

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": CRYPTO_EVENTS.map((event, index) => ({
    "@type": "Event",
    "position": index + 1,
    "name": event.title,
    "startDate": event.startDate,
    "endDate": event.endDate,
    "eventAttendanceMode": event.isVirtual 
      ? "https://schema.org/OnlineEventAttendanceMode" 
      : "https://schema.org/OfflineEventAttendanceMode",
    "eventStatus": "https://schema.org/EventScheduled",
    "location": {
      "@type": "Place",
      "name": event.location,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": event.city,
        "addressCountry": event.country
      }
    },
    "description": event.description,
    "organizer": {
      "@type": "Organization",
      "name": event.organizer
    }
  }))
};
---

<BaseLayout
  title="Krypto-Events, Konferenzen & Web3-Summits 2026 | newskrypt"
  description="Verifiziertes globales Verzeichnis führender Krypto-Konferenzen, Web3-Summits, Devcons, TOKEN2049 und Blockchain-Hackathons."
  canonicalUrl="https://cryptopulse.news/events"
  structuredData={eventSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    
    <!-- Page Header -->
    <header class="mb-10 pb-8 border-b border-slate-200">
      <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
        <a href="/" class="hover:text-amber-600">Startseite</a>
        <span>/</span>
        <span class="text-slate-900 font-medium">Krypto-Eventkalender</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight flex items-center gap-3">
            <span class="text-amber-500">🗓️</span>
            <span>Globale Krypto-Events &amp; Summits</span>
          </h1>
          <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-3xl leading-relaxed">
            Entdecken Sie verifizierte internationale Web3-Konferenzen, Entwickler-Hackathons, institutionelle Krypto-Gipfel und Blockchain-Messen.
          </p>
        </div>

        <div class="shrink-0 flex items-center gap-2 bg-white border border-slate-200 px-4 py-2.5 rounded-2xl text-xs text-slate-700 shadow-xs">
          <span class="font-bold text-amber-600 text-base">{CRYPTO_EVENTS.length}</span>
          <span class="font-medium">Kommende verifizierte Events</span>
        </div>
      </div>
    </header>

    <AdPlacement format="leaderboard" />

    <!-- Featured Flagship Summits Section -->
    <section class="my-10">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-6">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
          <span>🔥</span>
          <span>Top-Gipfeltreffen &amp; Highlight-Events</span>
        </h2>
        <span class="text-xs font-semibold text-amber-600">Internationale Keynotes</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredEvents.map((ev) => (
          <div class="bg-white border border-slate-200 hover:border-amber-400/60 rounded-3xl p-6 transition-all shadow-xs flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="px-2.5 py-1 bg-amber-500/10 border border-amber-500/30 text-amber-700 rounded-full text-[10px] font-extrabold uppercase tracking-wider">
                  {ev.eventType}
                </span>
                <span class="text-xs font-mono font-bold text-slate-500">
                  {ev.startDate}
                </span>
              </div>

              <h3 class="text-lg font-black text-slate-900 group-hover:text-amber-600 transition-colors mb-2 leading-snug">
                <a href={ev.website} target="_blank" rel="noopener noreferrer" class="hover:underline">
                  {ev.title}
                </a>
              </h3>

              <p class="text-xs text-slate-600 leading-relaxed mb-4 line-clamp-3">
                {ev.description}
              </p>

              <!-- Key Information Tags -->
              <div class="space-y-2 pt-3 border-t border-slate-100 text-xs text-slate-700">
                <div class="flex items-center gap-2">
                  <span class="text-slate-400">📍</span>
                  <span class="font-bold text-slate-900">{ev.location}, {ev.city}, {ev.country}</span>
                </div>
                {ev.startTime && (
                  <div class="flex items-center gap-2 text-[11px] text-amber-800 font-semibold">
                    <span class="text-amber-500">⏰</span>
                    <span>Tagesplan: <strong>{ev.startTime} - {ev.endTime}</strong> ({ev.timeZone})</span>
                  </div>
                )}
                <div class="flex items-center gap-2">
                  <span class="text-slate-400">🎟️</span>
                  <span>Tickets: <strong class="text-amber-700">{ev.ticketPrice}</strong></span>
                </div>
              </div>

              <!-- Speaker Highlights -->
              <div class="mt-4 pt-3 border-t border-slate-100">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1.5">Hauptsprecher</span>
                <div class="flex flex-wrap gap-1">
                  {ev.keySpeakers.map((sp) => (
                    <span class="px-2 py-0.5 bg-slate-100 text-slate-800 rounded-md text-[10px] font-semibold">
                      {sp}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-[11px] font-medium text-slate-500">Veranstalter: {ev.organizer}</span>
              <a
                href={ev.website}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 bg-slate-900 hover:bg-amber-600 text-white font-bold text-xs rounded-xl transition-colors shadow-xs inline-flex items-center gap-1"
              >
                <span>Event-Portal</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Complete Directory Table / Grid -->
    <section class="my-12">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-6">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
          <span>🌐</span>
          <span>Vollständiger Krypto- &amp; Blockchain-Veranstaltungskalender</span>
        </h2>
        <span class="text-xs font-semibold text-slate-500">Chronologische Reihenfolge</span>
      </div>

      <div class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-extrabold uppercase tracking-wider text-slate-500">
                <th class="py-4 px-6">Event &amp; Typ</th>
                <th class="py-4 px-4">Datum</th>
                <th class="py-4 px-4">Ort</th>
                <th class="py-4 px-4">Themen</th>
                <th class="py-4 px-6 text-right">Aktion</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs text-slate-800">
              {allEvents.map((ev) => (
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-4 px-6">
                    <div class="font-bold text-slate-900 text-sm mb-0.5">
                      <a href={ev.website} target="_blank" rel="noopener noreferrer" class="hover:text-amber-600 transition-colors">
                        {ev.title}
                      </a>
                    </div>
                    <div class="flex items-center gap-2 text-[10px]">
                      <span class="font-bold text-amber-700">{ev.organizer}</span>
                      <span class="text-slate-300">•</span>
                      <span class="px-1.5 py-0.5 bg-slate-100 border border-slate-200 rounded text-slate-600 font-semibold">{ev.eventType}</span>
                    </div>
                  </td>
                  <td class="py-4 px-4 whitespace-nowrap font-mono text-[11px] font-bold text-slate-700">
                    {ev.startDate} <br />
                    <span class="text-[10px] text-slate-400 font-normal">bis {ev.endDate}</span>
                    {ev.startTime && (
                      <div class="text-[10px] text-amber-700 font-sans font-bold mt-1">
                        ⏰ {ev.startTime} - {ev.endTime}
                      </div>
                    )}
                  </td>
                  <td class="py-4 px-4">
                    <div class="font-semibold text-slate-900">{ev.city}, {ev.country}</div>
                    <div class="text-[10px] text-slate-500 truncate max-w-[180px]">{ev.location}</div>
                  </td>
                  <td class="py-4 px-4">
                    <div class="flex flex-wrap gap-1 max-w-[220px]">
                      {ev.topics.slice(0, 3).map((top) => (
                        <span class="px-1.5 py-0.5 bg-slate-100 text-slate-600 rounded text-[10px]">
                          #{top}
                        </span>
                      ))}
                    </div>
                  </td>
                  <td class="py-4 px-6 text-right whitespace-nowrap">
                    <a
                      href={ev.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-3 py-1.5 bg-slate-100 hover:bg-amber-500 hover:text-slate-950 text-slate-900 font-bold text-xs rounded-xl transition-all inline-block border border-slate-200"
                    >
                      Website besuchen ↗
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
