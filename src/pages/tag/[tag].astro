---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AdPlacement from '../../components/AdPlacement.astro';

export function slugifyTag(tag: string): string {
  return tag
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, '')
    .replace(/[\s_-]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

export async function getStaticPaths() {
  const rawArticles = await getCollection('news');
  const articles = rawArticles.map(a => ({
    ...a,
    slug: a.id.replace(/\.md$/, '')
  }));

  const tagMap = new Map();

  articles.forEach(article => {
    (article.data.tags || []).forEach((tag) => {
      const slug = tag
        .toLowerCase()
        .trim()
        .replace(/[^\w\s-]/g, '')
        .replace(/[\s_-]+/g, '-')
        .replace(/^-+|-+$/g, '');

      if (!tagMap.has(slug)) {
        tagMap.set(slug, { originalTag: tag, articles: [] });
      }
      tagMap.get(slug).articles.push(article);
    });
  });

  return Array.from(tagMap.entries()).map(([tagSlug, data]) => {
    const sortedArticles = data.articles.sort(
      (a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()
    );

    return {
      params: { tag: tagSlug },
      props: {
        tagName: data.originalTag,
        tagSlug,
        articles: sortedArticles
      }
    };
  });
}

const { tagName, tagSlug, articles } = Astro.props;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://cryptopulse.news"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": `Tag: #${tagName}`,
      "item": `https://cryptopulse.news/tag/${tagSlug}`
    }
  ]
};
---

<BaseLayout
  title={`#${tagName} News & Market Intelligence | CryptoPulse`}
  description={`Browse verified digital asset intelligence, regulatory briefs, and market analysis tagged with #${tagName}.`}
  canonicalUrl={`https://cryptopulse.news/tag/${tagSlug}`}
  structuredData={breadcrumbSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    
    <header class="mb-10 pb-8 border-b border-slate-200">
      <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
        <a href="/" class="hover:text-amber-600">Home</a>
        <span>/</span>
        <span class="text-slate-700 font-medium">Tags</span>
        <span>/</span>
        <span class="text-amber-700 font-bold">#{tagName}</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight flex items-center gap-3">
            <span class="text-amber-600 font-mono">#</span>
            <span>{tagName}</span>
          </h1>
          <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-3xl leading-relaxed">
            Latest investigative reports, market intelligence, and verified research tagged with <strong class="text-slate-900">#{tagName}</strong>.
          </p>
        </div>

        <div class="shrink-0 flex items-center gap-2 bg-white border border-slate-200 px-4 py-2 rounded-xl text-xs text-slate-700 shadow-xs">
          <span class="font-bold text-amber-600">{articles.length}</span>
          <span>Related Stories</span>
        </div>
      </div>
    </header>

    <AdPlacement format="leaderboard" />

    {articles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map((art) => (
          <ArticleCard article={art} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-white border border-slate-200 rounded-2xl p-8 shadow-xs">
        <h3 class="text-base font-bold text-slate-900 mb-2">No Articles Found</h3>
        <p class="text-slate-500 text-xs sm:text-sm max-w-md mx-auto mb-6">
          Check back shortly for new updates tagged with #{tagName}.
        </p>
      </div>
    )}

  </div>
</BaseLayout>