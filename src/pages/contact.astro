---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kontakt & Redaktion"
  description="Kontaktieren Sie die Redaktion von newskrypt, senden Sie Hinweise, Korrekturwünsche oder Anfragen für Werbepartnerschaften."
  canonicalUrl="https://crypto-news-rose.vercel.app/contact"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <header class="mb-12">
      <h1 class="text-3xl sm:text-5xl font-black text-black tracking-tight mb-4">
        Kontakt zur Redaktion
      </h1>
      <p class="text-slate-700 text-sm sm:text-base leading-relaxed font-normal">
        Haben Sie einen vertraulichen Hinweis, eine Korrektur oder eine Anfrage? Unser Team antwortet Ihnen schnellstmöglich.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      
      <!-- Contact Form -->
      <div class="md:col-span-7 bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-xs">
        <h2 class="text-lg font-bold text-black mb-6">Nachricht senden</h2>
        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Ihre Nachricht wurde erfolgreich an die newskrypt Redaktion gesendet.');">
          <div>
            <label class="block text-xs font-semibold text-black mb-1.5">Vollständiger Name</label>
            <input type="text" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm text-black focus:outline-none focus:border-amber-500 focus:bg-white transition-colors" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-black mb-1.5">E-Mail-Adresse</label>
            <input type="email" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm text-black focus:outline-none focus:border-amber-500 focus:bg-white transition-colors" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-black mb-1.5">Betreff / Art der Anfrage</label>
            <select class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm text-black focus:outline-none focus:border-amber-500 focus:bg-white transition-colors">
              <option>Redaktioneller Hinweis / Eilmeldung</option>
              <option>Korrekturwunsch</option>
              <option>Interviewanfrage</option>
              <option>Sponsoring &amp; Werbung</option>
              <option>Technischer Support</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-black mb-1.5">Nachricht / Details</label>
            <textarea rows="5" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm text-black focus:outline-none focus:border-amber-500 focus:bg-white transition-colors"></textarea>
          </div>

          <button type="submit" class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs sm:text-sm rounded-xl shadow-md transition-all cursor-pointer">
            Nachricht absenden
          </button>
        </form>
      </div>

      <!-- Department Contacts -->
      <div class="md:col-span-5 space-y-6">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs">
          <h3 class="text-sm font-bold text-black mb-2">🔒 Vertrauliche Hinweise</h3>
          <p class="text-xs text-black mb-2">Für wichtige Leaks, Sicherheitslücken oder vertrauliche Nachrichten:</p>
          <p class="text-xs font-mono text-black font-bold">newskryptowahrung26@gmail.com</p>
          <p class="text-[10px] text-slate-600 mt-1">PGP-Schlüssel auf Anfrage verfügbar.</p>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs">
          <h3 class="text-sm font-bold text-black mb-2">📰 Presse &amp; Redaktion</h3>
          <p class="text-xs text-black mb-1">Pressemitteilungen &amp; Medienanfragen:</p>
          <p class="text-xs font-mono text-black font-bold">newskryptowahrung26@gmail.com</p>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs">
          <h3 class="text-sm font-bold text-black mb-2">🤝 Werbung &amp; Kooperationen</h3>
          <p class="text-xs text-black mb-1">Anzeigen, Konferenzen &amp; Sponsoring:</p>
          <p class="text-xs font-mono text-black font-bold">newskryptowahrung26@gmail.com</p>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>