---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Redaktionsrichtlinien & Journalistische Standards"
  description="newskrypt Redaktionsrichtlinien: Unabhängiger Finanzjournalismus, Bildrechte, Titel-Vorgaben und Verifizierung von Primärquellen."
  canonicalUrl="https://cryptopulse.news/editorial-policy"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <header class="mb-10 pb-6 border-b border-slate-200">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-cyan-500/10 border border-cyan-500/30 rounded-full text-xs font-extrabold text-cyan-800 uppercase tracking-wider mb-4">
        <span>🛡️ Offizielle Redaktionsstandards</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-black tracking-tight mb-3">
        Redaktionsrichtlinien & Journalistische Standards
      </h1>
      <p class="text-xs text-slate-500 font-medium">Zuletzt geprüft & ratifiziert: September 2026 | Chefredaktion & Integritäts-Desk</p>
    </header>

    <div class="space-y-8 text-sm text-black leading-relaxed">
      <!-- Section 1: Core Journalistic Integrity -->
      <section class="bg-white border border-slate-200 p-6 sm:p-8 rounded-2xl shadow-xs">
        <h2 class="text-xl font-black text-black mb-3 flex items-center gap-2">
          <span>1. Journalistische Integrität & Verifizierung von Primärquellen</span>
        </h2>
        <p class="text-black mb-3">
          <strong>newskrypt</strong> arbeitet nach den Grundsätzen des Qualitäts-Finanzjournalismus: Unparteilichkeit, Faktentreue und Verifizierung von Primärquellen. Jeder Marktbericht und Artikel wird vor Veröffentlichung anhand offizieller Dokumente (BaFin, MiCA, SEC, Gerichtsakten, On-Chain-Daten) geprüft.
        </p>
      </section>

      <!-- Section 2: Strict Publishing Standards -->
      <section class="bg-white border border-slate-200 p-6 sm:p-8 rounded-2xl shadow-xs">
        <h2 class="text-xl font-black text-black mb-3">2. Publikations- & Qualitätsstandards</h2>
        <div class="space-y-4">
          <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
            <h3 class="font-bold text-black text-base mb-1">Regel A: Einzigartige Bilder & Mediennutzung</h3>
            <p class="text-slate-800 text-xs sm:text-sm">
              Jeder Artikel enthält 1 bis 3 eindeutige, kontextbezogene Bilder. Eine Mehrfachnutzung derselben Bild-URL über verschiedene Artikel hinweg ist ausgeschlossen.
            </p>
          </div>

          <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
            <h3 class="font-bold text-black text-base mb-1">Regel B: Präzise Titel & Überschriften</h3>
            <p class="text-slate-800 text-xs sm:text-sm">
              Artikel-Titel sind auf 100 % Einzigartigkeit geprüft und hinsichtlich der SEO-Länge optimiert, um eine präzise Darstellung in Suchmaschinen zu gewährleisten.
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>