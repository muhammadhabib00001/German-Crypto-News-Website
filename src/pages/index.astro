---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdPlacement from '../components/AdPlacement.astro';
import BreakingBanner from '../components/BreakingBanner.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, CATEGORY_LIST } from '../data/categories';
import { MARKET_METRICS, MARKET_COINS } from '../data/market';
import { UPCOMING_TOKENS } from '../data/upcomingTokens';

const rawNews = await getCollection('news');

const allNews = (rawNews || []).map(article => ({
  ...article,
  slug: article.id.replace(/\.md$/, '')
})).sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());

const heroArticle = allNews[0] || null;
const subHeroArticles = allNews.slice(1, 3);
const trendingStories = allNews.slice(0, 5);

// Categorized Feeds (with default fallback to empty arrays)
const btcArticles = allNews.filter(a => a.data.category === 'bitcoin');
const ethArticles = allNews.filter(a => a.data.category === 'ethereum');
const defiWeb3Articles = allNews.filter(a => ['defi', 'web3'].includes(a.data.category));
const altcoinArticles = allNews.filter(a => a.data.category === 'altcoins');
const regulationMarketArticles = allNews.filter(a => ['crypto-regulation', 'crypto-markets'].includes(a.data.category));
const techSecurityArticles = allNews.filter(a => ['crypto-security', 'technology', 'mining'].includes(a.data.category));

// Home Page Schema
const homeSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "newskrypt | Deutsches Krypto-Nachrichtenportal & Finanzanalysen",
  "description": "Echtzeit-Krypto-Nachrichten, Bitcoin-Kurstrends, BaFin/MiCA-Regulierung, Ethereum-Layer-2, DePIN und verifizierte Token-Presales im DACH-Raum.",
  "url": "https://cryptopulse.news",
  "publisher": {
    "@type": "NewsMediaOrganization",
    "name": "newskrypt",
    "url": "https://cryptopulse.news",
    "logo": {
      "@type": "ImageObject",
      "url": "https://cryptopulse.news/logo.png"
    }
  }
};
---

<BaseLayout
  title="Deutsches Krypto-Nachrichtenportal, Bitcoin-Kurse & Marktanalysen"
  description="newskrypt ist Ihr führendes deutsches Finanzportal für Krypto-Nachrichten, Bitcoin-Analysen, BaFin/MiCA-Regulierungen, Altcoins & Token-Presales."
  canonicalUrl="https://cryptopulse.news"
  structuredData={homeSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-12">
    
    <!-- Breaking News Ticker Banner -->
    {heroArticle ? (
      <BreakingBanner title={heroArticle.data.title} slug={heroArticle.slug} />
    ) : (
      <div class="bg-amber-50 border border-amber-200 py-3 px-4 rounded-xl text-xs font-bold text-amber-900 flex items-center justify-between shadow-2xs">
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
          <span>Willkommen bei newskrypt – Das deutsche Krypto-Nachrichtenportal</span>
        </span>
        <span class="text-slate-600 font-normal">Tägliche Berichterstattung aus dem DACH-Raum</span>
      </div>
    )}

    <!-- HERO SECTION: Original 3-Column Layout (Hero Article + Sub-Hero List + Market Movers Sidebar) -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Column 1: Main Featured Hero Article (6 Cols) -->
      {heroArticle ? (
        <div class="lg:col-span-6 group flex flex-col">
          <article class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-xs hover:shadow-md transition-all duration-300 flex flex-col h-full">
            <a href={`/nachrichten/${heroArticle.slug}`} class="block relative aspect-[16/9] overflow-hidden bg-slate-100">
              <img
                src={heroArticle.data.featuredImage}
                alt={heroArticle.data.imageAlt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="eager"
              />
              <div class="absolute top-3 left-3 flex items-center gap-2">
                <span class="px-2.5 py-1 bg-amber-500 text-slate-950 rounded-md text-[11px] font-black uppercase tracking-wider shadow-md">
                  Eilmeldung
                </span>
                <span class="px-2.5 py-1 bg-black/80 backdrop-blur-md text-white rounded-md text-[11px] font-bold capitalize">
                  {CATEGORIES[heroArticle.data.category]?.name || heroArticle.data.category}
                </span>
              </div>
            </a>

            <div class="p-6 flex flex-col justify-between flex-1">
              <div>
                <div class="flex items-center gap-3 text-xs text-slate-500 mb-2 font-medium">
                  <span>Von {heroArticle.data.author.replace('-', ' ')}</span>
                  <span>•</span>
                  <span>{new Date(heroArticle.data.publishedDate).toLocaleDateString('de-DE', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
                  <span>•</span>
                  <span>{heroArticle.data.readingTime} Lesezeit</span>
                </div>

                <h1 class="text-xl sm:text-3xl font-black text-slate-900 group-hover:text-amber-600 transition-colors leading-tight tracking-tight mb-3">
                  <a href={`/nachrichten/${heroArticle.slug}`}>
                    {heroArticle.data.title}
                  </a>
                </h1>

                <p class="text-slate-700 text-sm leading-relaxed line-clamp-3 mb-4">
                  {heroArticle.data.excerpt}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <a
                  href={`/nachrichten/${heroArticle.slug}`}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 hover:text-amber-800 transition-colors"
                >
                  <span>Analysebericht lesen</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </article>
        </div>
      ) : (
        <div class="lg:col-span-6 bg-white border border-slate-200 rounded-2xl p-8 text-center flex flex-col items-center justify-center min-h-[360px]">
          <span class="text-4xl mb-3">📰</span>
          <h2 class="text-xl font-black text-slate-900 mb-2">Bereit für automatische Berichterstattung</h2>
          <p class="text-xs text-slate-600 max-w-md leading-relaxed">
            Das Redaktionssystem ist vollständig konfiguriert. Täglich erscheinen neue Marktberichte zu Bitcoin, BaFin/MiCA-Regulierung und Altcoins.
          </p>
        </div>
      )}

      <!-- Column 2: Secondary Sub-Hero Feed (3 Cols) -->
      <div class="lg:col-span-3 flex flex-col gap-4">
        {subHeroArticles.length > 0 ? (
          subHeroArticles.map((art) => (
            <article class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-xs hover:border-slate-300 transition-all flex flex-col group flex-1">
              <a href={`/nachrichten/${art.slug}`} class="block relative aspect-[16/9] overflow-hidden bg-slate-100">
                <img
                  src={art.data.featuredImage}
                  alt={art.data.imageAlt}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="eager"
                />
                <span class="absolute top-2 left-2 px-2 py-0.5 bg-black/80 text-white rounded text-[10px] font-bold">
                  {CATEGORIES[art.data.category]?.name || art.data.category}
                </span>
              </a>
              <div class="p-4 flex flex-col justify-between flex-1">
                <h3 class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-amber-600 line-clamp-2 leading-snug transition-colors mb-2">
                  <a href={`/nachrichten/${art.slug}`}>
                    {art.data.title}
                  </a>
                </h3>
                <span class="text-[10px] text-slate-500 font-medium">
                  {new Date(art.data.publishedDate).toLocaleDateString('de-DE', { month: 'short', day: 'numeric' })}
                </span>
              </div>
            </article>
          ))
        ) : (
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 text-center flex-1 flex flex-col items-center justify-center">
            <span class="text-xs font-bold text-slate-500">Krypto-Feeds in Vorbereitung</span>
          </div>
        )}
      </div>

      <!-- Column 3: Market Movers & Trending Sidebar (3 Cols) -->
      <div class="lg:col-span-3 space-y-4">
        
        <!-- Live Market Movers Widget -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-3">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900 flex items-center gap-1.5">
              <span>📈</span>
              <span>Marktbewegungen (24h)</span>
            </h2>
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          </div>

          <div class="space-y-2.5">
            {(MARKET_COINS || []).slice(0, 5).map((coin) => (
              <div class="flex items-center justify-between text-xs py-1 border-b border-slate-100 last:border-0">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-slate-900">{coin.symbol}</span>
                  <span class="text-slate-400 text-[10px]">{coin.name}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="font-mono text-slate-700 text-[11px] font-semibold">
                    {coin.priceEur ? `${coin.priceEur.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} €` : `${(coin.price / 1.1596).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} €`}
                  </span>
                  <span class={`font-bold font-mono text-[11px] w-12 text-right ${coin.change24h >= 0 ? 'text-emerald-600' : 'text-rose-600'}`}>
                    {coin.change24h >= 0 ? '+' : ''}{coin.change24h}%
                  </span>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-3 pt-2.5 border-t border-slate-200 flex items-center justify-between text-[11px] text-slate-500">
            <span>Fear &amp; Greed: <strong class="text-emerald-600">{MARKET_METRICS.fearAndGreedIndex} ({MARKET_METRICS.fearAndGreedSentiment})</strong></span>
            <a href="/kategorie/crypto-markets" class="text-amber-600 font-bold hover:underline">Heatmap →</a>
          </div>
        </div>

        <!-- Trending Stories Ranked (1 to 5) -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3 flex items-center gap-2">
            <span>🔥</span>
            <span>Trending Stories</span>
          </h2>

          {trendingStories.length > 0 ? (
            <div class="space-y-3">
              {trendingStories.map((item, idx) => (
                <div class="flex items-start gap-2.5 group">
                  <span class="text-xl font-black text-slate-300 group-hover:text-amber-600 transition-colors shrink-0 font-mono w-5">
                    0{idx + 1}
                  </span>
                  <div class="flex-1 min-w-0">
                    <span class="text-[9px] uppercase font-bold text-amber-700 block">
                      {CATEGORIES[item.data.category]?.name || item.data.category}
                    </span>
                    <h4 class="text-xs font-bold text-slate-900 group-hover:text-amber-600 line-clamp-2 leading-snug transition-colors">
                      <a href={`/nachrichten/${item.slug}`}>
                        {item.data.title}
                      </a>
                    </h4>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-xs text-slate-500">Wird beim Veröffentlichen aktualisiert.</p>
          )}
        </div>

        <!-- Upcoming Token Launches Spotlight Widget -->
        <div class="bg-gradient-to-br from-amber-500/10 via-white to-amber-500/5 border border-amber-500/30 rounded-2xl p-4 shadow-xs">
          <div class="flex items-center justify-between pb-2.5 border-b border-amber-500/20 mb-2.5">
            <h2 class="text-xs font-bold uppercase tracking-wider text-black flex items-center gap-1.5">
              <span>🚀</span>
              <span>Token-Starts &amp; Presales</span>
            </h2>
            <span class="text-[9px] font-bold text-amber-700 bg-amber-500/10 px-1.5 py-0.5 rounded">
              Presales
            </span>
          </div>
          <p class="text-xs text-slate-700 leading-relaxed mb-3">
            Verfolgen Sie neue Token-Launches, Presale-Termine und Projektdaten in Echtzeit.
          </p>
          <a
            href="/token-starts"
            class="w-full py-2 bg-black hover:bg-slate-800 text-white font-bold text-xs rounded-xl text-center block transition-colors shadow-xs"
          >
            Alle Launches anzeigen →
          </a>
        </div>

      </div>

    </section>

    <!-- Top Leaderboard Ad Placement -->
    <AdPlacement format="leaderboard" />

    <!-- Section 1: Bitcoin & Ethereum In-Depth -->
    {btcArticles.concat(ethArticles).length > 0 && (
      <section class="my-12">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-6">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
            <span class="text-amber-500">₿</span>
            <span>Bitcoin &amp; Ethereum im Detail</span>
          </h2>
          <div class="flex items-center gap-3 text-xs">
            <a href="/kategorie/bitcoin" class="text-slate-500 hover:text-slate-900 font-bold">Bitcoin News →</a>
            <span class="text-slate-300">|</span>
            <a href="/kategorie/ethereum" class="text-slate-500 hover:text-slate-900 font-bold">Ethereum Hub →</a>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {btcArticles.concat(ethArticles).slice(0, 3).map((art) => (
            <ArticleCard article={art} />
          ))}
        </div>
      </section>
    )}

    <!-- Section 2: Crypto Regulation & Market Macro Intelligence -->
    {regulationMarketArticles.length > 0 && (
      <section class="my-12 bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-200 mb-6 gap-2">
          <div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
              <span>⚖️</span>
              <span>Regulierung &amp; Marktanalysen</span>
            </h2>
            <p class="text-xs text-slate-500 mt-1">BaFin-Mitteilungen, MiCA-Richtlinien, Liquidationen und institutionelle Kapitalflüsse.</p>
          </div>
          <a href="/kategorie/crypto-regulation" class="text-xs font-bold text-amber-600 hover:underline shrink-0">
            Zum Regulierungs-Desk →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {regulationMarketArticles.slice(0, 3).map((art) => (
            <ArticleCard article={art} />
          ))}
        </div>
      </section>
    )}

    <!-- Mid-Page In-Article Sponsor Ad -->
    <AdPlacement format="leaderboard" label="Institutional Partner" />

    <!-- Section 3: DeFi, Web3 & High-Speed Altcoins -->
    {defiWeb3Articles.concat(altcoinArticles).length > 0 && (
      <section class="my-12">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-6">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
            <span>⚡</span>
            <span>DeFi, Web3 &amp; Altcoin-Ökosysteme</span>
          </h2>
          <div class="flex items-center gap-3 text-xs">
            <a href="/kategorie/defi" class="text-slate-500 hover:text-slate-900 font-bold">DeFi →</a>
            <a href="/kategorie/altcoins" class="text-slate-500 hover:text-slate-900 font-bold">Altcoins →</a>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {defiWeb3Articles.concat(altcoinArticles).slice(0, 3).map((art) => (
            <ArticleCard article={art} />
          ))}
        </div>
      </section>
    )}

    <!-- Section 4: Security, Mining & Advanced Technology -->
    {techSecurityArticles.length > 0 && (
      <section class="my-12">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-6">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
            <span>🛡️</span>
            <span>Sicherheit, Mining &amp; Technologie</span>
          </h2>
          <a href="/kategorie/crypto-security" class="text-xs font-bold text-amber-600 hover:underline">
            Sicherheits-Audits →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {techSecurityArticles.slice(0, 3).map((art) => (
            <ArticleCard article={art} />
          ))}
        </div>
      </section>
    )}

    <!-- All Categories Fast Navigator -->
    <section class="my-12 p-6 bg-white border border-slate-200 rounded-2xl shadow-xs">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-4">
        Alle {CATEGORY_LIST.length} Krypto-Sektoren &amp; Themenbereiche
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-8 gap-2">
        {CATEGORY_LIST.map((cat) => (
          <a
            href={`/kategorie/${cat.slug}`}
            class="px-3 py-2 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-amber-400/50 rounded-xl text-center transition-all group"
          >
            <span class="text-xs font-bold text-slate-700 group-hover:text-amber-600 block truncate">
              {cat.name}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Institutional Alpha Newsletter Box -->
    <NewsletterBox />

  </div>
</BaseLayout>