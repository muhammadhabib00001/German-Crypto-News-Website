---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TokenCard from '../components/TokenCard.astro';
import AdPlacement from '../components/AdPlacement.astro';
import CryptoMarketsHub from '../components/CryptoMarketsHub.astro';
import BreakingBanner from '../components/BreakingBanner.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, CATEGORY_LIST } from '../data/categories';
import { UPCOMING_TOKENS } from '../data/upcomingTokens';

const rawNews = await getCollection('news');

const allNews = rawNews.map(article => ({
  ...article,
  slug: article.id.replace(/\.md$/, '')
})).sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());

const heroArticle = allNews[0];
const subHeroArticles = allNews.slice(1, 4);
const latestNews = allNews.slice(4, 10);

// Categorized Feeds
const btcArticles = allNews.filter(a => a.data.category === 'bitcoin');
const ethArticles = allNews.filter(a => a.data.category === 'ethereum');
const defiWeb3Articles = allNews.filter(a => ['defi', 'web3'].includes(a.data.category));
const altcoinArticles = allNews.filter(a => a.data.category === 'altcoins');
const regulationMarketArticles = allNews.filter(a => ['crypto-regulation', 'crypto-markets'].includes(a.data.category));
const techSecurityArticles = allNews.filter(a => ['crypto-security', 'technology', 'mining'].includes(a.data.category));

// Top Featured Token Launches for Spotlight Widget
const featuredTokenSpotlight = UPCOMING_TOKENS.filter(t => t.isFeatured).slice(0, 3);

// Home Page Schema
const homeSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "newskrypt | Deutsches Krypto-Nachrichtenportal & Finanzanalysen",
  "description": "Echtzeit-Krypto-Nachrichten, Bitcoin-Kurstrends, BaFin/MiCA-Regulierung, Ethereum-Layer-2, DePIN und verifizierte Token-Presales im DACH-Raum.",
  "url": "https://cryptopulse.news",
  "publisher": {
    "@type": "NewsMediaOrganization",
    "name": "newskrypt",
    "url": "https://cryptopulse.news",
    "logo": {
      "@type": "ImageObject",
      "url": "https://cryptopulse.news/logo.png"
    }
  }
};
---

<BaseLayout
  title="Deutsches Krypto-Nachrichtenportal, Bitcoin-Kurse & Marktanalysen"
  description="newskrypt ist Ihr führendes deutsches Finanzportal für Krypto-Nachrichten, Bitcoin-Analysen, BaFin/MiCA-Regulierungen, Altcoins & Token-Presales."
  canonicalUrl="https://cryptopulse.news"
  structuredData={homeSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-12">
    
    <!-- Breaking News Ticker Banner -->
    {heroArticle && (
      <BreakingBanner title={heroArticle.data.title} slug={heroArticle.slug} />
    )}

    <!-- HERO SECTION: Split Grid Layout -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Primary Featured Hero Article (8 Cols) -->
      {heroArticle && (
        <div class="lg:col-span-8 group">
          <article class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col h-full">
            <a href={`/nachrichten/${heroArticle.slug}`} class="block relative aspect-[16/9] overflow-hidden bg-slate-100">
              <img
                src={heroArticle.data.featuredImage}
                alt={heroArticle.data.imageAlt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="eager"
              />
              <div class="absolute top-4 left-4 flex items-center gap-2">
                <span class="px-3 py-1 bg-amber-500 text-slate-950 rounded-full text-xs font-black uppercase tracking-wider shadow-lg">
                  Eilmeldung
                </span>
                <span class="px-3 py-1 bg-black/80 backdrop-blur-md text-white rounded-full text-xs font-bold capitalize">
                  {CATEGORIES[heroArticle.data.category]?.name || heroArticle.data.category}
                </span>
              </div>
            </a>

            <div class="p-6 sm:p-8 flex flex-col justify-between flex-1">
              <div>
                <div class="flex items-center gap-3 text-xs text-slate-600 font-medium mb-3">
                  <span class="font-semibold text-slate-800">Von {heroArticle.data.author.replace('-', ' ')}</span>
                  <span>•</span>
                  <span>{new Date(heroArticle.data.publishedDate).toLocaleDateString('de-DE', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
                  <span>•</span>
                  <span>{heroArticle.data.readingTime} Lesezeit</span>
                </div>

                <h1 class="text-2xl sm:text-4xl font-black text-black group-hover:text-amber-600 transition-colors leading-tight tracking-tight mb-4">
                  <a href={`/nachrichten/${heroArticle.slug}`}>
                    {heroArticle.data.title}
                  </a>
                </h1>

                <p class="text-slate-700 text-sm sm:text-base leading-relaxed line-clamp-3 mb-6 font-normal">
                  {heroArticle.data.excerpt}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <a
                  href={`/nachrichten/${heroArticle.slug}`}
                  class="inline-flex items-center gap-2 text-xs font-bold text-amber-700 hover:text-amber-800 transition-colors"
                >
                  <span>Vollständigen Analysebericht lesen</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </article>
        </div>
      )}

      <!-- Secondary Sub-Hero Feed & Trending (4 Cols) -->
      <div class="lg:col-span-4 flex flex-col justify-between space-y-6">
        <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-xs flex-1">
          <div class="flex items-center justify-between pb-4 border-b border-slate-200 mb-4">
            <h2 class="text-base font-extrabold text-black uppercase tracking-wide flex items-center gap-2">
              <span>🔥</span>
              <span>Trending Marktberichte</span>
            </h2>
            <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
          </div>

          <div class="space-y-4">
            {subHeroArticles.map((article, idx) => (
              <div class="group/sub flex items-start gap-3 pb-4 border-b border-slate-100 last:border-0 last:pb-0">
                <span class="text-2xl font-black text-slate-300 group-hover/sub:text-amber-600 transition-colors font-mono">
                  0{idx + 1}
                </span>
                <div>
                  <span class="text-[10px] font-extrabold uppercase tracking-wider text-amber-800 mb-1 block">
                    {CATEGORIES[article.data.category]?.name || article.data.category}
                  </span>
                  <h3 class="text-xs sm:text-sm font-bold text-black group-hover/sub:text-amber-700 transition-colors leading-snug line-clamp-2">
                    <a href={`/nachrichten/${article.slug}`}>
                      {article.data.title}
                    </a>
                  </h3>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Compact Newsletter Subscribe Widget -->
        <div class="bg-slate-900 text-white rounded-3xl p-6 shadow-xl border border-slate-800">
          <span class="text-[10px] font-extrabold uppercase tracking-wider text-amber-400 block mb-1">Tägliches Briefing</span>
          <h3 class="text-lg font-black mb-2">Krypto-Märkte im Überblick</h3>
          <p class="text-xs text-slate-300 mb-4 leading-relaxed">
            Erhalten Sie jeden Morgen verifizierte On-Chain-Analysen und BaFin-Regulierungs-Updates.
          </p>
          <form class="space-y-2" onsubmit="event.preventDefault(); alert('Vielen Dank für Ihre Anmeldung zum newskrypt Markt-Briefing!');">
            <input
              type="email"
              placeholder="Ihre E-Mail-Adresse..."
              required
              class="w-full px-3.5 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-xs text-white placeholder:text-slate-400 focus:outline-none focus:border-amber-500 transition-colors"
            />
            <button
              type="submit"
              class="w-full py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs rounded-xl shadow-md transition-all cursor-pointer"
            >
              Kostenlos Abonnieren
            </button>
          </form>
        </div>
      </div>

    </section>

    <!-- LIVE CRYPTO MARKET PRICES WIDGET -->
    <CryptoMarketsHub />

    <!-- UPCOMING TOKEN LAUNCHES SPOTLIGHT SECTION -->
    <section class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200 mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-800 text-xs font-bold mb-2">
            <span>🚀 Verifiziertes Launchpad-Hub</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">
            Top Token-Starts &amp; Aktive Presales
          </h2>
        </div>
        <a
          href="/token-starts"
          class="inline-flex items-center gap-1.5 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-black font-bold text-xs rounded-xl transition-colors shrink-0"
        >
          <span>Alle Token-Launches anzeigen</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredTokenSpotlight.map((token) => (
          <TokenCard token={token} />
        ))}
      </div>
    </section>

    <!-- SECTION 1: BITCOIN & ETHEREUM SPOTLIGHT -->
    <section class="my-12">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-6">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
          <span class="text-amber-500">₿</span>
          <span>Bitcoin &amp; Ethereum im Detail</span>
        </h2>
        <div class="flex items-center gap-3 text-xs">
          <a href="/kategorie/bitcoin" class="text-slate-500 hover:text-slate-900 font-bold">Bitcoin News →</a>
          <span class="text-slate-300">|</span>
          <a href="/kategorie/ethereum" class="text-slate-500 hover:text-slate-900 font-bold">Ethereum Hub →</a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {btcArticles.concat(ethArticles).slice(0, 3).map((art) => (
          <ArticleCard article={art} />
        ))}
      </div>
    </section>

    <!-- SECTION 2: REGULATION & MARKET MACRO -->
    <section class="my-12 bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-200 mb-6 gap-2">
        <div>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
            <span>⚖️</span>
            <span>Regulierung &amp; Marktanalysen</span>
          </h2>
          <p class="text-xs text-slate-500 mt-1">BaFin-Mitteilungen, MiCA-Richtlinien, Liquidationen und institutionelle Kapitalflüsse.</p>
        </div>
        <a href="/kategorie/crypto-regulation" class="text-xs font-bold text-amber-600 hover:underline shrink-0">
          Zum Regulierungs-Desk →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {regulationMarketArticles.slice(0, 3).map((art) => (
          <ArticleCard article={art} />
        ))}
      </div>
    </section>

    <AdPlacement format="leaderboard" />

    <!-- SECTION 3: DEFI, WEB3 & ALTCOINS -->
    <section class="my-12">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-6">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
          <span>⚡</span>
          <span>DeFi, Web3 &amp; Altcoin-Ökosysteme</span>
        </h2>
        <div class="flex items-center gap-3 text-xs">
          <a href="/kategorie/defi" class="text-slate-500 hover:text-slate-900 font-bold">DeFi →</a>
          <a href="/kategorie/altcoins" class="text-slate-500 hover:text-slate-900 font-bold">Altcoins →</a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {defiWeb3Articles.concat(altcoinArticles).slice(0, 3).map((art) => (
          <ArticleCard article={art} />
        ))}
      </div>
    </section>

    <!-- SECTION 4: SECURITY & TECHNOLOGY -->
    <section class="my-12">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-6">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
          <span>🛡️</span>
          <span>Sicherheit, Mining &amp; Technologie</span>
        </h2>
        <a href="/kategorie/crypto-security" class="text-xs font-bold text-amber-600 hover:underline">
          Sicherheits-Audits →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {techSecurityArticles.slice(0, 3).map((art) => (
          <ArticleCard article={art} />
        ))}
      </div>
    </section>

    <!-- FAST CATEGORIES NAVIGATOR GRID -->
    <section class="my-12 p-6 bg-white border border-slate-200 rounded-2xl shadow-xs">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-4">
        Alle {CATEGORY_LIST.length} Krypto-Sektoren &amp; Themenbereiche
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-8 gap-2">
        {CATEGORY_LIST.map((cat) => (
          <a
            href={`/kategorie/${cat.slug}`}
            class="px-3 py-2 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-amber-400/50 rounded-xl text-center transition-all group"
          >
            <span class="text-xs font-bold text-slate-700 group-hover:text-amber-600 block truncate">
              {cat.name}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- INSTITUTIONAL NEWSLETTER BOX -->
    <NewsletterBox />

  </div>
</BaseLayout>