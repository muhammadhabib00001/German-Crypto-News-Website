---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TokenCard from '../../components/TokenCard.astro';
import { UPCOMING_TOKENS } from '../../data/upcomingTokens';

const totalTokens = UPCOMING_TOKENS.length;
const presaleCount = UPCOMING_TOKENS.filter(t => t.category === 'presale').length;
const cryptoCount = UPCOMING_TOKENS.filter(t => t.category === 'crypto').length;
const memeCount = UPCOMING_TOKENS.filter(t => t.category === 'meme').length;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Upcoming Crypto Token Launches, Presales & Meme Coins | newskrypt",
  "description": "Comprehensive institutional intelligence tracker monitoring upcoming token launches, active presales, IDO/IEO schedules, and meme token fair launches with live automated on-chain updates.",
  "url": "https://cryptopulse.news/token-launches"
};
---

<BaseLayout
  title="Upcoming Token Launches, Presales & Meme Coins 2026"
  description="Explore upcoming crypto tokens, active presales, and viral meme coin launches. Track launch dates, countdown timers, tokenomics, and security audit scores with live automatic feeds."
  canonicalUrl="https://cryptopulse.news/token-launches"
  structuredData={pageSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-14">
    
    <!-- Hero Header Zone -->
    <header class="mb-10 text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-800 text-xs font-bold mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Live Automated Token Tracking & Launchpad Hub</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-black tracking-tight mb-4">
        Upcoming Token Launches & Presales
      </h1>
      <p class="text-slate-700 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto">
        Track cryptocurrency token launches, early-stage presale rounds, and high-velocity meme coin bonding curves updated automatically from on-chain pools and verified research indexes.
      </p>

      <!-- Auto-refresh status bar -->
      <div class="inline-flex items-center gap-3 mt-4 px-4 py-1.5 bg-slate-100 rounded-full border border-slate-200 text-xs text-slate-700">
        <span class="flex items-center gap-1.5 font-semibold text-emerald-700">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Auto-Sync: <span id="sync-status">Hourly Sync Active</span>
        </span>
        <span class="text-slate-300">|</span>
        <span class="text-slate-600 font-medium">Cycle: <strong>Every Hour</strong></span>
        <span class="text-slate-300">|</span>
        <span id="last-sync-time" class="font-mono text-slate-600">Updated just now</span>
        <button id="refresh-tokens-btn" class="hover:text-black font-bold flex items-center gap-1 transition-colors cursor-pointer text-slate-600 ml-1">
          <span>🔄</span>
          <span>Refresh</span>
        </button>
      </div>
    </header>

    <!-- Quick Stat Highlights Banner -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs text-center">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1">Total Tracked</span>
        <span id="stat-total" class="text-2xl sm:text-3xl font-black text-black">{totalTokens} Projects</span>
        <span class="text-[11px] text-emerald-600 font-semibold block mt-1">✓ Automated Multi-Feed</span>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs text-center">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1">Active Presales</span>
        <span id="stat-presales" class="text-2xl sm:text-3xl font-black text-amber-600">{presaleCount} Presales</span>
        <span class="text-[11px] text-slate-600 block mt-1">Seed & Private Rounds</span>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs text-center">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1">Utility & Infra</span>
        <span id="stat-crypto" class="text-2xl sm:text-3xl font-black text-blue-600">{cryptoCount} Tokens</span>
        <span class="text-[11px] text-slate-600 block mt-1">DeFi, AI, ZK & L2</span>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs text-center">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1">Meme Tokens</span>
        <span id="stat-memes" class="text-2xl sm:text-3xl font-black text-rose-600">{memeCount} Memes</span>
        <span class="text-[11px] text-slate-600 block mt-1">Fair Launches & DEXs</span>
      </div>
    </div>

    <!-- Category & Chain Filter Tabs -->
    <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-6 mb-8 shadow-xs">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        
        <!-- Category Segmented Buttons -->
        <div class="flex items-center gap-1.5 p-1 bg-slate-100 rounded-xl overflow-x-auto no-scrollbar">
          <button
            type="button"
            class="filter-cat-btn active px-4 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer bg-white text-black shadow-xs"
            data-category="all"
          >
            All Launches (<span id="btn-count-all">{totalTokens}</span>)
          </button>
          <button
            type="button"
            class="filter-cat-btn px-4 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer text-slate-600 hover:text-black"
            data-category="presale"
          >
            Presale Tokens (<span id="btn-count-presale">{presaleCount}</span>)
          </button>
          <button
            type="button"
            class="filter-cat-btn px-4 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer text-slate-600 hover:text-black"
            data-category="crypto"
          >
            Crypto Tokens (<span id="btn-count-crypto">{cryptoCount}</span>)
          </button>
          <button
            type="button"
            class="filter-cat-btn px-4 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer text-slate-600 hover:text-black"
            data-category="meme"
          >
            Meme Tokens (<span id="btn-count-meme">{memeCount}</span>)
          </button>
        </div>

        <!-- Blockchain Filter Dropdown -->
        <div class="flex items-center gap-3">
          <label for="chain-filter" class="text-xs font-bold text-slate-600 shrink-0">Chain:</label>
          <select
            id="chain-filter"
            class="px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold text-black focus:outline-none focus:border-amber-500 cursor-pointer"
          >
            <option value="all">All Blockchains (Multi-Chain)</option>
            <option value="Solana">Solana 🟣</option>
            <option value="Ethereum">Ethereum 🔷</option>
            <option value="Base">Base 🔵</option>
            <option value="Arbitrum">Arbitrum 🔵</option>
            <option value="BNB Chain">BNB Chain 🟡</option>
            <option value="Sui">Sui 💧</option>
            <option value="TON">TON 💎</option>
          </select>
        </div>

      </div>
    </div>

    <!-- Tokens Grid -->
    <div id="tokens-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {UPCOMING_TOKENS.map((tok) => (
        <TokenCard token={tok} />
      ))}
    </div>

    <!-- Empty State (Hidden by default) -->
    <div id="no-tokens-found" class="hidden text-center py-16 bg-white border border-slate-200 rounded-2xl p-8 mb-12 shadow-xs">
      <h3 class="text-base font-bold text-black mb-2">No Matching Tokens Found</h3>
      <p class="text-slate-600 text-xs sm:text-sm max-w-md mx-auto mb-4">
        No projects match your current category and blockchain filters. Try selecting "All Launches" or resetting the chain filter.
      </p>
      <button
        id="reset-filter-btn"
        class="px-4 py-2 bg-black text-white text-xs font-bold rounded-xl hover:bg-slate-800 transition-colors cursor-pointer"
      >
        Reset Filters
      </button>
    </div>

    <!-- Investor Due Diligence & Risk Notice Box -->
    <section class="bg-amber-50 border border-amber-200 rounded-2xl p-6 sm:p-8 text-black shadow-xs mb-12">
      <div class="flex items-start gap-3">
        <span class="text-2xl shrink-0">⚠</span>
        <div>
          <h2 class="text-base font-bold text-black mb-2 uppercase tracking-wide">
            Mandatory Due Diligence Notice on Upcoming Token Launches
          </h2>
          <p class="text-xs sm:text-sm text-black leading-relaxed mb-3">
            Participating in early-stage cryptocurrency presales, decentralized initial DEX offerings (IDOs), and meme token fair launches carries extreme risk of partial or complete capital loss. Smart contract exploits, liquidity drainage, team allocations, and sudden regulatory adjustments are inherent hazards in nascent digital asset protocols.
          </p>
          <p class="text-xs text-black font-semibold">
            newskrypt publishes token launch profiles strictly for informational and news evaluation purposes. None of our content constitutes investment or financial advice. Always verify smart contract bytecode, independent audit certificates, and lockup proofs before committing capital.
          </p>
        </div>
      </div>
    </section>

    <!-- Project Founder Submission Banner -->
    <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 text-center shadow-xs">
      <h2 class="text-xl sm:text-2xl font-bold text-black mb-2">Launching a Web3 Project or Presale?</h2>
      <p class="text-slate-700 text-xs sm:text-sm max-w-xl mx-auto mb-5 leading-relaxed">
        Submit your token for editorial review and verification by our cryptographic research analysts. Gain visibility across our institutional and retail readership.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-5 py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs sm:text-sm rounded-xl shadow-md transition-all cursor-pointer"
      >
        <span>Submit Project for Verification</span>
        <span>→</span>
      </a>
    </section>

  </div>
</BaseLayout>

<script is:inline>
  // Countdown Timer Logic
  function updateCountdownTimers() {
    const clocks = document.querySelectorAll('.countdown-clock');
    const now = new Date().getTime();

    clocks.forEach((clock) => {
      const targetStr = clock.getAttribute('data-target-date');
      if (!targetStr) return;

      const target = new Date(targetStr).getTime();
      const diff = target - now;

      if (diff <= 0) {
        clock.textContent = 'Launched / Live';
        clock.classList.add('text-emerald-700');
        clock.classList.remove('text-black');
      } else {
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const secs = Math.floor((diff % (1000 * 60)) / 1000);

        clock.textContent = `${days}d ${hours}h ${mins}m ${secs}s`;
      }
    });
  }

  updateCountdownTimers();
  setInterval(updateCountdownTimers, 1000);

  // Category & Blockchain Filtering Logic
  const catButtons = document.querySelectorAll('.filter-cat-btn');
  const chainSelect = document.getElementById('chain-filter');
  const emptyState = document.getElementById('no-tokens-found');
  const resetBtn = document.getElementById('reset-filter-btn');

  let activeCategory = 'all';
  let activeChain = 'all';

  function applyFilters() {
    const cards = document.querySelectorAll('.token-card');
    let visibleCount = 0;

    cards.forEach((card) => {
      const cardCat = card.getAttribute('data-category');
      const cardChain = card.getAttribute('data-chain');

      const matchCat = activeCategory === 'all' || cardCat === activeCategory;
      const matchChain = activeChain === 'all' || cardChain === activeChain;

      if (matchCat && matchChain) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }
  }

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      catButtons.forEach(b => {
        b.classList.remove('active', 'bg-white', 'text-black', 'shadow-xs');
        b.classList.add('text-slate-600');
      });
      btn.classList.add('active', 'bg-white', 'text-black', 'shadow-xs');
      btn.classList.remove('text-slate-600');

      activeCategory = btn.getAttribute('data-category') || 'all';
      applyFilters();
    });
  });

  if (chainSelect) {
    chainSelect.addEventListener('change', (e) => {
      activeChain = e.target.value;
      applyFilters();
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      activeCategory = 'all';
      activeChain = 'all';
      if (chainSelect) chainSelect.value = 'all';
      catButtons.forEach((b, i) => {
        if (i === 0) {
          b.classList.add('active', 'bg-white', 'text-black', 'shadow-xs');
          b.classList.remove('text-slate-600');
        } else {
          b.classList.remove('active', 'bg-white', 'text-black', 'shadow-xs');
          b.classList.add('text-slate-600');
        }
      });
      applyFilters();
    });
  }

  // Automated Live Token Loader from API
  async function loadAutomatedTokens() {
    const syncStatus = document.getElementById('sync-status');
    const lastSyncTime = document.getElementById('last-sync-time');
    const container = document.getElementById('tokens-container');

    if (syncStatus) syncStatus.textContent = 'Syncing...';

    try {
      const res = await fetch('/api/tokens.json');
      if (!res.ok) throw new Error('Network error');
      const data = await res.json();

      if (data && Array.isArray(data.tokens) && data.tokens.length > 0) {
        // Render automated tokens into container
        const existingCards = new Set(Array.from(document.querySelectorAll('.token-card')).map(c => c.getAttribute('data-token-id')));

        let addedCount = 0;
        data.tokens.forEach((tok) => {
          if (existingCards.has(tok.id)) return;

          const riskBadgeClasses = {
            'Low': 'bg-emerald-50 text-emerald-700 border-emerald-200',
            'Medium': 'bg-blue-50 text-blue-700 border-blue-200',
            'High': 'bg-amber-50 text-amber-700 border-amber-200',
            'Extreme / Degen': 'bg-rose-50 text-rose-700 border-rose-200'
          }[tok.riskRating] || 'bg-slate-50 text-slate-700 border-slate-200';

          const card = document.createElement('div');
          card.className = 'token-card bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-xs hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between';
          card.setAttribute('data-category', tok.category);
          card.setAttribute('data-chain', tok.blockchain);
          card.setAttribute('data-launch-date', tok.launchDate);
          card.setAttribute('data-token-id', tok.id);

          const websiteBtn = tok.links?.website ? `
            <a href="${tok.links.website}" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-slate-700 hover:text-black hover:bg-slate-100 px-2.5 py-1.5 rounded-lg border border-slate-200 transition-colors inline-flex items-center gap-1">
              <span>Website</span>
              <span>↗</span>
            </a>
          ` : '';

          const actionBtn = tok.links?.dexscreener ? `
            <a href="${tok.links.dexscreener}" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-white bg-black hover:bg-slate-800 px-3 py-1.5 rounded-lg shadow-xs transition-colors inline-flex items-center gap-1">
              <span>View On-Chain</span>
              <span>↗</span>
            </a>
          ` : `
            <a href="${tok.links?.website || '#'}" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-white bg-black hover:bg-slate-800 px-3 py-1.5 rounded-lg shadow-xs transition-colors inline-flex items-center gap-1">
              <span>Details</span>
              <span>→</span>
            </a>
          `;

          card.innerHTML = `
            <div>
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="flex items-center gap-3">
                  <img src="${tok.logo}" alt="${tok.name} icon" class="w-12 h-12 rounded-xl object-cover border border-slate-200 shadow-xs shrink-0" loading="lazy" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1639762681485-074b7f938ba0?w=160&auto=format&fit=crop&q=80';" />
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="text-base font-bold text-black leading-tight">${tok.name}</h3>
                      <span class="text-xs font-mono font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">$${tok.symbol}</span>
                    </div>
                    <div class="flex items-center gap-2 mt-1">
                      <span class="text-[11px] font-medium text-slate-600 flex items-center gap-1">
                        <span>${tok.chainIcon}</span>
                        <span>${tok.blockchain}</span>
                      </span>
                      <span class="text-slate-300">•</span>
                      <span class="text-[11px] font-semibold text-amber-700">${tok.categoryLabel}</span>
                    </div>
                  </div>
                </div>
                <span class="text-[11px] font-bold px-2.5 py-1 rounded-full border ${tok.badgeColor} shrink-0">${tok.stage}</span>
              </div>

              <p class="text-xs text-slate-700 leading-relaxed line-clamp-2 mb-4">${tok.shortDescription}</p>

              <div class="grid grid-cols-2 gap-2.5 bg-slate-50 border border-slate-200/80 rounded-xl p-3 mb-4 text-xs">
                <div>
                  <span class="text-[10px] uppercase font-bold text-slate-500 block">Status</span>
                  <span class="font-bold text-black text-[12px]">${tok.launchDateDisplay}</span>
                </div>
                <div>
                  <span class="text-[10px] uppercase font-bold text-slate-500 block">Price / Target</span>
                  <span class="font-bold text-black text-[12px]">${tok.targetListingPrice || 'TBA'}</span>
                </div>
                <div>
                  <span class="text-[10px] uppercase font-bold text-slate-500 block">Cap / FDV</span>
                  <span class="font-semibold text-slate-800 text-[11px]">${tok.hardCap || 'Dynamic'}</span>
                </div>
                <div>
                  <span class="text-[10px] uppercase font-bold text-slate-500 block">Audit & Source</span>
                  <span class="font-semibold text-slate-800 flex items-center gap-1 text-[11px]">
                    <span class="text-emerald-600">✓</span>
                    <span>${tok.securityAudit.score || 'Verified'}</span>
                  </span>
                </div>
              </div>

              <div class="flex items-center justify-between bg-amber-500/5 border border-amber-500/20 rounded-xl px-3 py-2 text-xs mb-4">
                <div class="flex items-center gap-1.5 text-amber-800 font-bold text-[11px]">
                  <span>⏳</span>
                  <span>Launch Countdown:</span>
                </div>
                <div class="countdown-clock font-mono font-bold text-black text-xs" data-target-date="${tok.launchDate}">Calculating...</div>
              </div>

              <div class="mb-4">
                <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1.5">Live Token Allocation</span>
                <div class="flex h-2 rounded-full overflow-hidden bg-slate-100 gap-0.5">
                  <div style="width: ${tok.tokenomics.presale}%;" class="bg-amber-500" title="Sale: ${tok.tokenomics.presale}%"></div>
                  <div style="width: ${tok.tokenomics.liquidity}%;" class="bg-blue-500" title="Liquidity: ${tok.tokenomics.liquidity}%"></div>
                  <div style="width: ${tok.tokenomics.stakingRewards}%;" class="bg-emerald-500" title="Staking: ${tok.tokenomics.stakingRewards}%"></div>
                  <div style="width: ${tok.tokenomics.team}%;" class="bg-slate-400" title="Team: ${tok.tokenomics.team}%"></div>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-200 flex items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-bold px-2 py-0.5 rounded border ${riskBadgeClasses}">
                  ${tok.riskRating}
                </span>
                <span class="text-[10px] font-mono font-bold bg-emerald-50 text-emerald-700 px-1.5 py-0.5 rounded border border-emerald-200">
                  AUTO-LIVE
                </span>
              </div>
              <div class="flex items-center gap-2">
                ${websiteBtn}
                ${actionBtn}
              </div>
            </div>
          `;

          container.appendChild(card);
          addedCount++;
        });

        // Update statistics and button counts
        const allCards = document.querySelectorAll('.token-card');
        const countAll = allCards.length;
        const countPresale = document.querySelectorAll('.token-card[data-category="presale"]').length;
        const countCrypto = document.querySelectorAll('.token-card[data-category="crypto"]').length;
        const countMeme = document.querySelectorAll('.token-card[data-category="meme"]').length;

        const statTotal = document.getElementById('stat-total');
        const statPresales = document.getElementById('stat-presales');
        const statCrypto = document.getElementById('stat-crypto');
        const statMemes = document.getElementById('stat-memes');

        if (statTotal) statTotal.textContent = `${countAll} Projects`;
        if (statPresales) statPresales.textContent = `${countPresale} Presales`;
        if (statCrypto) statCrypto.textContent = `${countCrypto} Tokens`;
        if (statMemes) statMemes.textContent = `${countMeme} Memes`;

        const btnAll = document.getElementById('btn-count-all');
        const btnPre = document.getElementById('btn-count-presale');
        const btnCry = document.getElementById('btn-count-crypto');
        const btnMem = document.getElementById('btn-count-meme');

        if (btnAll) btnAll.textContent = countAll;
        if (btnPre) btnPre.textContent = countPresale;
        if (btnCry) btnCry.textContent = countCrypto;
        if (btnMem) btnMem.textContent = countMeme;

        if (syncStatus) syncStatus.textContent = 'Active Sync';
        if (lastSyncTime) {
          const now = new Date();
          lastSyncTime.textContent = `Synced ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
        }

        updateCountdownTimers();
        applyFilters();
      }
    } catch (err) {
      console.warn('Auto-sync notice:', err);
      if (syncStatus) syncStatus.textContent = 'Static Active';
    }
  }

  // Trigger auto-load on DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    loadAutomatedTokens();
  });

  // Also execute immediately in case DOM is already ready
  loadAutomatedTokens();

  // Automatically check for new/less tokens on an hourly basis
  const HOURLY_SYNC_INTERVAL_MS = 60 * 60 * 1000; // 1 hour
  setInterval(() => {
    loadAutomatedTokens();
  }, HOURLY_SYNC_INTERVAL_MS);

  const refreshBtn = document.getElementById('refresh-tokens-btn');
  if (refreshBtn) {
    refreshBtn.addEventListener('click', () => {
      loadAutomatedTokens();
    });
  }
</script>
