---
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-start justify-center pt-16 sm:pt-20 px-4"
  style="display: none;"
>
  <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-xl shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200 flex flex-col max-h-[80vh]">
    <div class="p-4 border-b border-slate-200 flex items-center gap-3 bg-white">
      <svg class="w-5 h-5 text-cyan-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Search Bitcoin, Ethereum, Solana, DeFi, Tokens..."
        class="flex-1 bg-transparent text-sm text-black placeholder-slate-400 focus:outline-none font-medium"
        autocomplete="off"
      />
      <button
        id="search-close-btn"
        class="text-xs px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg cursor-pointer transition-colors"
        aria-label="Close search"
      >
        ESC
      </button>
    </div>

    <!-- Suggested Fast Topics & Results Container -->
    <div class="p-4 overflow-y-auto flex-1 bg-slate-50/50">
      <div id="search-trending" class="mb-3">
        <div class="text-[11px] uppercase tracking-wider text-slate-600 font-bold mb-2">Trending Topics</div>
        <div class="flex flex-wrap gap-1.5 mb-2">
          <button type="button" data-query="Bitcoin" class="quick-topic-btn px-2.5 py-1 bg-white hover:bg-cyan-50 hover:border-cyan-300 border border-slate-200 text-slate-800 text-xs font-semibold rounded-lg transition-all cursor-pointer">Bitcoin ETF</button>
          <button type="button" data-query="Ethereum" class="quick-topic-btn px-2.5 py-1 bg-white hover:bg-cyan-50 hover:border-cyan-300 border border-slate-200 text-slate-800 text-xs font-semibold rounded-lg transition-all cursor-pointer">Ethereum Layer 2</button>
          <button type="button" data-query="Regulation" class="quick-topic-btn px-2.5 py-1 bg-white hover:bg-cyan-50 hover:border-cyan-300 border border-slate-200 text-slate-800 text-xs font-semibold rounded-lg transition-all cursor-pointer">MiCA Regulation</button>
          <button type="button" data-query="Solana" class="quick-topic-btn px-2.5 py-1 bg-white hover:bg-cyan-50 hover:border-cyan-300 border border-slate-200 text-slate-800 text-xs font-semibold rounded-lg transition-all cursor-pointer">Solana TVL</button>
          <button type="button" data-query="DeFi" class="quick-topic-btn px-2.5 py-1 bg-white hover:bg-cyan-50 hover:border-cyan-300 border border-slate-200 text-slate-800 text-xs font-semibold rounded-lg transition-all cursor-pointer">DeFi Lending</button>
          <button type="button" data-query="Meme" class="quick-topic-btn px-2.5 py-1 bg-white hover:bg-cyan-50 hover:border-cyan-300 border border-slate-200 text-slate-800 text-xs font-semibold rounded-lg transition-all cursor-pointer">Meme Tokens</button>
        </div>
      </div>

      <div class="border-t border-slate-200 pt-3">
        <div class="text-[11px] uppercase tracking-wider text-slate-600 font-bold mb-2 flex justify-between items-center">
          <span>Search Results</span>
          <span id="search-count" class="text-[10px] text-slate-600 font-normal"></span>
        </div>
        <div id="search-results" class="text-xs text-slate-600 space-y-2">
          <p class="text-center py-6 text-slate-500">Type above or click a trending topic to search articles...</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    let searchArticles = [];
    let isFetched = false;

    async function loadSearchIndex() {
      if (isFetched) return;
      try {
        const res = await fetch('/api/search.json');
        if (res.ok) {
          searchArticles = await res.json();
          isFetched = true;
        }
      } catch (e) {
        console.error('Error loading search index:', e);
      }
    }

    // Load search index immediately in background
    loadSearchIndex();

    window.openSearchModal = function() {
      const modal = document.getElementById('search-modal');
      if (modal) {
        modal.classList.remove('hidden');
        modal.style.display = 'flex';
        loadSearchIndex();
        setTimeout(() => {
          const input = document.getElementById('search-input');
          if (input) {
            input.focus();
            input.select();
          }
        }, 50);
      }
    };

    window.closeSearchModal = function() {
      const modal = document.getElementById('search-modal');
      if (modal) {
        modal.classList.add('hidden');
        modal.style.display = 'none';
      }
    };

    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('search-modal');
      const closeBtn = document.getElementById('search-close-btn');
      const searchInput = document.getElementById('search-input');
      const searchResults = document.getElementById('search-results');
      const searchCount = document.getElementById('search-count');

      if (closeBtn) {
        closeBtn.addEventListener('click', window.closeSearchModal);
      }

      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) window.closeSearchModal();
        });
      }

      // Quick topic buttons
      document.querySelectorAll('.quick-topic-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const q = e.currentTarget.getAttribute('data-query') || '';
          if (searchInput) {
            searchInput.value = q;
            performSearch(q);
          }
        });
      });

      function performSearch(query) {
        if (!searchResults) return;
        const q = (query || '').toLowerCase().trim();

        if (!q) {
          searchResults.innerHTML = '<p class="text-center py-6 text-slate-500">Type above or click a trending topic to search articles...</p>';
          if (searchCount) searchCount.textContent = '';
          return;
        }

        const filtered = searchArticles.filter(item => {
          const title = (item.title || '').toLowerCase();
          const cat = (item.category || '').toLowerCase();
          const exc = (item.excerpt || '').toLowerCase();
          const tags = Array.isArray(item.tags) ? item.tags.join(' ').toLowerCase() : '';
          return title.includes(q) || cat.includes(q) || exc.includes(q) || tags.includes(q);
        });

        if (searchCount) {
          searchCount.textContent = `${filtered.length} found`;
        }

        if (filtered.length === 0) {
          searchResults.innerHTML = `
            <div class="text-center py-8">
              <p class="text-slate-700 font-semibold mb-1">No articles found for "${query}"</p>
              <p class="text-slate-500 text-[11px]">Try checking for typos or searching another crypto keyword</p>
            </div>
          `;
          return;
        }

        searchResults.innerHTML = filtered.map(item => `
          <a href="/news/${item.slug}" class="flex items-start gap-3 p-3 rounded-xl bg-white hover:bg-cyan-50/70 border border-slate-200/80 hover:border-cyan-300 transition-all group">
            ${item.featuredImage ? `<img src="${item.featuredImage}" alt="" class="w-14 h-14 rounded-lg object-cover shrink-0 border border-slate-200" />` : ''}
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-[10px] uppercase font-bold text-cyan-700 tracking-wider">${item.category}</span>
                ${item.publishedDate ? `<span class="text-[10px] text-slate-400">• ${item.publishedDate}</span>` : ''}
              </div>
              <h4 class="font-bold text-black text-xs group-hover:text-cyan-600 transition-colors line-clamp-2 leading-snug">${item.title}</h4>
            </div>
          </a>
        `).join('');
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          performSearch(e.target.value);
        });
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        window.closeSearchModal();
      }
      if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        window.openSearchModal();
      }
    });
  })();
</script>
