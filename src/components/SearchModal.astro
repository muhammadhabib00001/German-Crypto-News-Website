---
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm hidden flex items-start justify-center pt-20 px-4"
>
  <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-xl shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
    <div class="p-4 border-b border-slate-200 flex items-center gap-3">
      <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Search Bitcoin, Ethereum, Solana, Regulations, DeFi..."
        class="flex-1 bg-transparent text-sm text-slate-900 placeholder-slate-400 focus:outline-none"
      />
      <button
        id="search-close-btn"
        class="text-xs px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded cursor-pointer"
      >
        ESC
      </button>
    </div>

    <!-- Suggested Fast Topics -->
    <div class="p-4">
      <div class="text-[11px] uppercase tracking-wider text-slate-500 font-bold mb-2">Trending Searches</div>
      <div class="flex flex-wrap gap-1.5 mb-4">
        <a href="/category/bitcoin" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs rounded-md">Bitcoin ETF Flows</a>
        <a href="/category/ethereum" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs rounded-md">Ethereum Layer 2</a>
        <a href="/category/crypto-regulation" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs rounded-md">MiCA Stablecoins</a>
        <a href="/category/altcoins" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs rounded-md">Solana Firedancer</a>
        <a href="/category/defi" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs rounded-md">Aave Morpho Blue</a>
      </div>

      <div id="search-results" class="text-xs text-slate-600 space-y-2 max-h-60 overflow-y-auto">
        <p class="text-center py-6 text-slate-400">Type above to search articles or click a topic...</p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const modal = document.getElementById('search-modal');
  const closeBtn = document.getElementById('search-close-btn');
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');

  const closeSearch = () => {
    if (modal) modal.classList.add('hidden');
  };

  if (closeBtn) closeBtn.addEventListener('click', closeSearch);
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeSearch();
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
  });

  // Client-side quick filter simulation
  const mockArticles = [
    { title: "Bitcoin Hits Record $89,000 as Institutional Inflows Cross $3.2B", slug: "bitcoin-hits-89k-institutional-inflows", category: "Bitcoin" },
    { title: "Ethereum Layer-2 Throughput Surpasses 2,500 TPS as Pectra Upgrade Approaches", slug: "ethereum-layer-2-throughput-records", category: "Ethereum" },
    { title: "Global Regulators Finalize Cross-Border Stablecoin Framework Ahead of MiCA", slug: "global-regulators-finalize-stablecoin-framework", category: "Crypto Regulation" },
    { title: "Solana Ecosystem Crosses $12B TVL as DePIN and High-Frequency Trading Surge", slug: "solana-ecosystem-tvl-crosses-12b", category: "Altcoins" },
    { title: "Decentralized Lending Protocols Generate $450M in Annualized Revenue", slug: "defi-lending-revenue-records", category: "DeFi" },
    { title: "Zero-Knowledge Rollups Introduce Native Privacy and Prover Optimization", slug: "zero-knowledge-rollups-native-privacy", category: "Blockchain" },
    { title: "Derivatives Liquidation Heatmap Reveals $1.8B Short Squeeze Potential at $92K", slug: "derivatives-liquidation-heatmap-92k", category: "Crypto Markets" },
    { title: "Smart Contract Security in the Age of Autonomous AI Audit Agents", slug: "smart-contract-security-ai-auditing", category: "Crypto Security" },
    { title: "Institutional Digital Asset Allocations Surge to 4.5% of Balanced Portfolios", slug: "institutional-digital-asset-allocations-surge", category: "Institutional Crypto" }
  ];

  if (searchInput && searchResults) {
    searchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      if (!q) {
        searchResults.innerHTML = '<p class="text-center py-6 text-slate-500">Type above to search articles or click a topic...</p>';
        return;
      }

      const filtered = mockArticles.filter(a => a.title.toLowerCase().includes(q) || a.category.toLowerCase().includes(q));

      if (filtered.length === 0) {
        searchResults.innerHTML = '<p class="text-center py-6 text-slate-500">No articles matched your search.</p>';
        return;
      }

      searchResults.innerHTML = filtered.map(item => `
        <a href="/news/${item.slug}" class="block p-2.5 rounded-lg bg-slate-800/60 hover:bg-slate-800 transition-colors">
          <span class="text-[10px] uppercase font-bold text-amber-400 block">${item.category}</span>
          <span class="font-medium text-white text-xs">${item.title}</span>
        </a>
      `).join('');
    });
  }
</script>
