---
interface Props {
  format: 'leaderboard' | 'rectangle' | 'sidebar';
  label?: string;
}

const { format, label = "Sponsored Advertisement" } = Astro.props;

const dimensions = {
  leaderboard: "min-h-[90px] max-w-[728px] w-full",
  rectangle: "min-h-[250px] max-w-[300px] w-full",
  sidebar: "min-h-[600px] max-w-[300px] w-full"
};
---

<div class="my-6 mx-auto flex flex-col items-center">
  <span class="text-[9px] uppercase tracking-widest text-slate-400 font-semibold mb-1.5">
    {label}
  </span>
  <div class={`bg-slate-100 border border-dashed border-slate-300 rounded-xl flex flex-col items-center justify-center p-4 text-center text-slate-500 ${dimensions[format]}`}>
    <!-- Ad Slot Placeholder: Ready for Google AdSense / Header Bidding Tag -->
    <div class="flex items-center gap-2 text-xs font-medium text-slate-600">
      <svg class="w-4 h-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      <span>Google AdSense / Direct Sponsor Zone</span>
    </div>
    <span class="text-[10px] text-slate-400 mt-1">Non-intrusive placement • 100% Core Web Vitals compliant</span>
  </div>
</div>
