---
import { CATEGORIES } from '../data/categories';

interface Props {
  article: {
    slug: string;
    data: {
      title: string;
      excerpt: string;
      category: string;
      author: string;
      publishedDate: string;
      readingTime: string;
      featuredImage: string;
      imageAlt: string;
      contentType?: string;
    };
  };
  featured?: boolean;
  compact?: boolean;
}

const { article, featured = false, compact = false } = Astro.props;
const categoryMeta = CATEGORIES[article.data.category] || {
  name: article.data.category,
  badgeColor: 'bg-slate-800 text-slate-300'
};

const formattedDate = new Date(article.data.publishedDate).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
});
---

{featured ? (
  <article class="group relative bg-slate-900/60 hover:bg-slate-900 border border-slate-800 hover:border-slate-700/80 rounded-2xl overflow-hidden transition-all duration-300 flex flex-col md:flex-row gap-6 p-6">
    <div class="md:w-1/2 overflow-hidden rounded-xl aspect-[16/10] relative bg-slate-950">
      <img
        src={article.data.featuredImage}
        alt={article.data.imageAlt}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="eager"
      />
      <div class="absolute top-3 left-3 flex gap-2">
        <span class={`px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider border backdrop-blur-md ${categoryMeta.badgeColor}`}>
          {categoryMeta.name}
        </span>
        {article.data.contentType && article.data.contentType !== 'news' && (
          <span class="px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider bg-slate-950/80 text-amber-400 border border-slate-700">
            {article.data.contentType}
          </span>
        )}
      </div>
    </div>

    <div class="md:w-1/2 flex flex-col justify-between py-1">
      <div>
        <div class="flex items-center gap-3 text-xs text-slate-400 mb-2.5">
          <span>{formattedDate}</span>
          <span>•</span>
          <span>{article.data.readingTime}</span>
        </div>
        
        <h2 class="text-xl sm:text-2xl font-black text-white group-hover:text-amber-400 transition-colors tracking-tight leading-snug mb-3">
          <a href={`/news/${article.slug}`}>
            {article.data.title}
          </a>
        </h2>

        <p class="text-slate-300 text-sm leading-relaxed line-clamp-3 mb-4">
          {article.data.excerpt}
        </p>
      </div>

      <div class="flex items-center justify-between pt-4 border-t border-slate-800/80">
        <a href={`/author/${article.data.author}`} class="text-xs font-semibold text-slate-400 hover:text-white transition-colors">
          By <span class="text-slate-200 capitalize">{article.data.author.replace('-', ' ')}</span>
        </a>
        <a href={`/news/${article.slug}`} class="text-xs font-bold text-amber-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
          Read Full Analysis →
        </a>
      </div>
    </div>
  </article>
) : compact ? (
  <article class="group flex gap-4 items-start py-3 border-b border-slate-800/60 last:border-0">
    <div class="w-20 h-20 shrink-0 overflow-hidden rounded-lg bg-slate-950">
      <img
        src={article.data.featuredImage}
        alt={article.data.imageAlt}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    </div>
    <div class="flex-1 min-w-0">
      <span class="text-[10px] font-bold uppercase tracking-wider text-amber-400 mb-1 block">
        {categoryMeta.name}
      </span>
      <h3 class="text-xs sm:text-sm font-bold text-white group-hover:text-amber-400 transition-colors line-clamp-2 leading-snug">
        <a href={`/news/${article.slug}`}>
          {article.data.title}
        </a>
      </h3>
      <div class="flex items-center gap-2 text-[10px] text-slate-400 mt-1.5">
        <span>{formattedDate}</span>
        <span>•</span>
        <span>{article.data.readingTime}</span>
      </div>
    </div>
  </article>
) : (
  <article class="group bg-slate-900/50 hover:bg-slate-900 border border-slate-800 hover:border-slate-700/80 rounded-xl overflow-hidden transition-all duration-300 flex flex-col h-full">
    <div class="aspect-[16/10] overflow-hidden relative bg-slate-950">
      <img
        src={article.data.featuredImage}
        alt={article.data.imageAlt}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
      <div class="absolute top-2.5 left-2.5">
        <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border backdrop-blur-md ${categoryMeta.badgeColor}`}>
          {categoryMeta.name}
        </span>
      </div>
    </div>

    <div class="p-4 flex-1 flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-2 text-[11px] text-slate-400 mb-2">
          <span>{formattedDate}</span>
          <span>•</span>
          <span>{article.data.readingTime}</span>
        </div>

        <h3 class="text-base font-bold text-white group-hover:text-amber-400 transition-colors line-clamp-2 leading-snug mb-2">
          <a href={`/news/${article.slug}`}>
            {article.data.title}
          </a>
        </h3>

        <p class="text-slate-400 text-xs leading-relaxed line-clamp-2 mb-4">
          {article.data.excerpt}
        </p>
      </div>

      <div class="flex items-center justify-between text-xs text-slate-400 pt-3 border-t border-slate-800/80">
        <span class="capitalize">By {article.data.author.replace('-', ' ')}</span>
        <span class="text-amber-400 group-hover:translate-x-0.5 transition-transform">Read →</span>
      </div>
    </div>
  </article>
)}
