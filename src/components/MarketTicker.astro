---
import { MARKET_COINS, MARKET_METRICS } from '../data/market';
---

<div class="bg-slate-100/90 border-b border-slate-200 text-xs text-slate-700 py-1.5 px-4 overflow-hidden select-none">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
    <!-- Macro Market Bar Overview -->
    <div class="hidden lg:flex items-center gap-5 text-[11px] shrink-0 border-r border-slate-200 pr-5">
      <div class="flex items-center gap-1.5">
        <span class="text-slate-500">Total Cap:</span>
        <span id="ticker-total-cap" class="font-bold text-slate-900 financial-num">{MARKET_METRICS.totalMarketCap}</span>
        <span id="ticker-cap-change" class={`font-semibold financial-num ${MARKET_METRICS.totalMarketCapChange24h >= 0 ? 'text-emerald-600' : 'text-rose-600'}`}>
          {MARKET_METRICS.totalMarketCapChange24h >= 0 ? '+' : ''}{MARKET_METRICS.totalMarketCapChange24h}%
        </span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="text-slate-500">24h Vol:</span>
        <span id="ticker-vol" class="font-bold text-slate-900 financial-num">{MARKET_METRICS.volume24h}</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="text-slate-500">Dominance:</span>
        <span id="ticker-btc-dom" class="text-slate-900 font-medium financial-num">BTC {MARKET_METRICS.btcDominance}%</span>
        <span class="text-slate-300">|</span>
        <span id="ticker-eth-dom" class="text-slate-900 font-medium financial-num">ETH {MARKET_METRICS.ethDominance}%</span>
      </div>
      <div class="flex items-center gap-1.5 bg-white px-2 py-0.5 rounded border border-slate-200 shadow-xs">
        <span class="text-slate-500">Sentiment:</span>
        <span id="ticker-fng" class="text-emerald-600 font-bold financial-num">{MARKET_METRICS.fearAndGreedIndex} ({MARKET_METRICS.fearAndGreedSentiment})</span>
      </div>
    </div>

    <!-- Scrolling Ticker Container -->
    <div class="flex-1 overflow-hidden relative">
      <div id="crypto-ticker-row" class="flex items-center gap-6 overflow-x-auto no-scrollbar py-0.5 whitespace-nowrap">
        {MARKET_COINS.map((coin) => (
          <div data-coin-symbol={coin.symbol} class="inline-flex items-center gap-2 shrink-0 bg-white hover:bg-slate-50 transition-colors px-2.5 py-1 rounded-lg border border-slate-200 shadow-xs">
            <span class="font-bold text-slate-900 tracking-wide">{coin.symbol}</span>
            <div class="inline-flex items-baseline gap-1.5 financial-num">
              <span class="coin-price text-slate-900 font-bold transition-all duration-300">${coin.price.toLocaleString(undefined, { minimumFractionDigits: coin.price < 1 ? 4 : 2, maximumFractionDigits: coin.price < 1 ? 4 : 2 })}</span>
              <span class="coin-price-eur text-slate-400 font-semibold text-[10px] transition-all duration-300">€{coin.priceEur.toLocaleString(undefined, { minimumFractionDigits: coin.priceEur < 1 ? 4 : 2, maximumFractionDigits: coin.priceEur < 1 ? 4 : 2 })}</span>
            </div>
            <span class={`coin-change font-semibold financial-num text-[11px] ${coin.change24h >= 0 ? 'text-emerald-600' : 'text-rose-600'}`}>
              {coin.change24h >= 0 ? '▲' : '▼'} {Math.abs(coin.change24h)}%
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Live indicator -->
    <div class="hidden sm:flex items-center gap-2 pl-3 shrink-0 text-[11px] text-slate-400">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span id="live-status-text" class="font-semibold text-emerald-600">Live USD / EUR</span>
    </div>
  </div>
</div>

<!-- Real-time sub-second WebSocket price streaming with Binance and REST fallback -->
<script is:inline>
  const SYMBOL_MAP = {
    'btcusdt': 'BTC',
    'ethusdt': 'ETH',
    'solusdt': 'SOL',
    'bnbusdt': 'BNB',
    'xrpusdt': 'XRP',
    'adausdt': 'ADA',
    'avaxusdt': 'AVAX',
    'linkusdt': 'LINK'
  };

  let eurUsdRate = 1.1596; // Default 1 EUR = ~1.1596 USD
  const lastPrices = {};

  function formatPrice(val) {
    return val.toLocaleString(undefined, {
      minimumFractionDigits: val < 1 ? 4 : 2,
      maximumFractionDigits: val < 1 ? 4 : 2
    });
  }

  function applyPriceUpdate(symbol, newPrice, changePercent) {
    const prev = lastPrices[symbol] || newPrice;
    const isUp = newPrice >= prev;
    lastPrices[symbol] = newPrice;
    const eurPrice = newPrice / eurUsdRate;

    // 1. Update top scrolling ticker
    document.querySelectorAll(`[data-coin-symbol="${symbol}"]`).forEach((el) => {
      const priceEl = el.querySelector('.coin-price');
      const priceEurEl = el.querySelector('.coin-price-eur');
      const changeEl = el.querySelector('.coin-change');
      if (priceEl) {
        priceEl.textContent = '$' + formatPrice(newPrice);
        priceEl.classList.remove('text-emerald-500', 'text-rose-500');
        priceEl.classList.add(isUp ? 'text-emerald-500' : 'text-rose-500');
        setTimeout(() => {
          priceEl.classList.remove('text-emerald-500', 'text-rose-500');
        }, 500);
      }
      if (priceEurEl) {
        priceEurEl.textContent = '€' + formatPrice(eurPrice);
      }
      if (changeEl && changePercent !== undefined) {
        const ch = Number(changePercent);
        const pos = ch >= 0;
        changeEl.className = `coin-change font-semibold financial-num text-[11px] ${pos ? 'text-emerald-600' : 'text-rose-600'}`;
        changeEl.textContent = `${pos ? '▲' : '▼'} ${Math.abs(ch).toFixed(2)}%`;
      }
    });

    // 2. Update homepage sidebar Market Movers widget
    document.querySelectorAll(`[data-mover-symbol="${symbol}"]`).forEach((el) => {
      const priceEl = el.querySelector('.mover-price');
      const priceEurEl = el.querySelector('.mover-price-eur');
      const changeEl = el.querySelector('.mover-change');
      if (priceEl) {
        priceEl.textContent = '$' + formatPrice(newPrice);
        priceEl.classList.remove('text-emerald-500', 'text-rose-500');
        priceEl.classList.add(isUp ? 'text-emerald-500' : 'text-rose-500');
        setTimeout(() => {
          priceEl.classList.remove('text-emerald-500', 'text-rose-500');
        }, 500);
      }
      if (priceEurEl) {
        priceEurEl.textContent = '€' + formatPrice(eurPrice);
      }
      if (changeEl && changePercent !== undefined) {
        const ch = Number(changePercent);
        const pos = ch >= 0;
        changeEl.className = `mover-change font-bold financial-num text-[11px] w-14 text-right ${pos ? 'text-emerald-600' : 'text-rose-600'}`;
        changeEl.textContent = `${pos ? '+' : ''}${ch.toFixed(2)}%`;
      }
    });
  }

  // Connect to Binance live multi-stream WebSocket for sub-second trade ticks (including EURUSDT forex)
  function initLiveWebSocket() {
    const coinStreams = Object.keys(SYMBOL_MAP).map(s => `${s}@ticker`);
    coinStreams.push('eurusdt@ticker');
    const wsUrl = `wss://stream.binance.com:9443/ws/${coinStreams.join('/')}`;
    let socket;

    try {
      socket = new WebSocket(wsUrl);

      socket.onopen = () => {
        const status = document.getElementById('live-status-text');
        if (status) status.textContent = 'Live USD / EUR';
      };

      socket.onmessage = (event) => {
        try {
          const data = JSON.parse(event.data);
          const rawSymbol = (data.s || '').toLowerCase();
          
          // Track live EUR / USDT rate for real-time forex conversion
          if (rawSymbol === 'eurusdt' && data.c) {
            const parsedRate = parseFloat(data.c);
            if (parsedRate > 0.5 && parsedRate < 2.0) {
              eurUsdRate = parsedRate;
            }
            return;
          }

          const symbol = SYMBOL_MAP[rawSymbol];
          if (symbol && data.c) {
            const currentPrice = parseFloat(data.c);
            const priceChangePercent = parseFloat(data.P);
            applyPriceUpdate(symbol, currentPrice, priceChangePercent);
          }
        } catch (err) {
          // ignore parsing error
        }
      };

      socket.onerror = () => {
        fallbackPolling();
      };

      socket.onclose = () => {
        setTimeout(initLiveWebSocket, 3000);
      };
    } catch (e) {
      fallbackPolling();
    }
  }

  // Fallback fast polling via CoinGecko
  async function fallbackPolling() {
    try {
      const res = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,binancecoin,ripple,cardano,avalanche-2,chainlink&vs_currencies=usd,eur&include_24hr_change=true');
      if (!res.ok) return;
      const data = await res.json();
      const map = {
        'BTC': data.bitcoin,
        'ETH': data.ethereum,
        'SOL': data.solana,
        'BNB': data.binancecoin,
        'XRP': data.ripple,
        'ADA': data.cardano,
        'AVAX': data['avalanche-2'],
        'LINK': data.chainlink
      };
      Object.entries(map).forEach(([sym, obj]) => {
        if (obj && obj.usd) {
          if (obj.eur && obj.usd) {
            eurUsdRate = obj.usd / obj.eur;
          }
          applyPriceUpdate(sym, obj.usd, obj.usd_24h_change);
        }
      });
    } catch (e) {}
  }

  if (typeof window !== 'undefined') {
    initLiveWebSocket();
  }
</script>