---
// Component: LanguageSelector.astro
// Provides an elegant dropdown with comprehensive global languages
// Uses Google Translate element with zero intrusive branding, clean cookies, and instant translation.
---

<div class="relative inline-block text-left" id="lang-selector-wrapper">
  <!-- Trigger Button -->
  <button
    id="lang-menu-btn"
    type="button"
    class="flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-xl transition-all cursor-pointer select-none"
    aria-expanded="false"
    aria-haspopup="true"
    title="Sprache wählen"
  >
    <span class="text-sm">🌐</span>
    <span id="current-lang-code" class="uppercase text-[11px] font-extrabold tracking-wide">DE</span>
    <svg class="w-3 h-3 text-slate-500 transition-transform duration-200" id="lang-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Language Dropdown Menu -->
  <div
    id="lang-dropdown-menu"
    class="hidden absolute left-0 sm:left-auto sm:right-0 mt-2 w-52 rounded-2xl bg-white border border-slate-200 shadow-2xl p-2 z-50 animate-in fade-in slide-in-from-top-2 duration-150"
    role="menu"
    aria-orientation="vertical"
  >
    <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-3 py-1.5 border-b border-slate-100 mb-1 flex items-center justify-between">
      <span>In Ihrer Sprache lesen</span>
      <span class="text-cyan-600 font-semibold">Sprachen</span>
    </div>

    <div class="max-h-72 overflow-y-auto no-scrollbar space-y-0.5">
      <button type="button" class="lang-option-btn w-full text-left px-3 py-2 text-xs font-semibold rounded-xl hover:bg-slate-100 flex items-center justify-between transition-colors text-slate-800 cursor-pointer" data-lang="de">
        <span class="flex items-center gap-2"><span>🇩🇪</span> <span>Deutsch</span></span>
        <span class="text-[10px] text-slate-400 font-mono">DE</span>
      </button>

      <button type="button" class="lang-option-btn w-full text-left px-3 py-2 text-xs font-semibold rounded-xl hover:bg-slate-100 flex items-center justify-between transition-colors text-slate-800 cursor-pointer" data-lang="en">
        <span class="flex items-center gap-2"><span>🇺🇸</span> <span>English</span></span>
        <span class="text-[10px] text-slate-400 font-mono">EN</span>
      </button>

      <button type="button" class="lang-option-btn w-full text-left px-3 py-2 text-xs font-semibold rounded-xl hover:bg-slate-100 flex items-center justify-between transition-colors text-slate-800 cursor-pointer" data-lang="es">
        <span class="flex items-center gap-2"><span>🇪🇸</span> <span>Español</span></span>
        <span class="text-[10px] text-slate-400 font-mono">ES</span>
      </button>

      <button type="button" class="lang-option-btn w-full text-left px-3 py-2 text-xs font-semibold rounded-xl hover:bg-slate-100 flex items-center justify-between transition-colors text-slate-800 cursor-pointer" data-lang="fr">
        <span class="flex items-center gap-2"><span>🇫🇷</span> <span>Français</span></span>
        <span class="text-[10px] text-slate-400 font-mono">FR</span>
      </button>

      <button type="button" class="lang-option-btn w-full text-left px-3 py-2 text-xs font-semibold rounded-xl hover:bg-slate-100 flex items-center justify-between transition-colors text-slate-800 cursor-pointer" data-lang="it">
        <span class="flex items-center gap-2"><span>🇮🇹</span> <span>Italiano</span></span>
        <span class="text-[10px] text-slate-400 font-mono">IT</span>
      </button>

      <button type="button" class="lang-option-btn w-full text-left px-3 py-2 text-xs font-semibold rounded-xl hover:bg-slate-100 flex items-center justify-between transition-colors text-slate-800 cursor-pointer" data-lang="pt">
        <span class="flex items-center gap-2"><span>🇵🇹</span> <span>Português</span></span>
        <span class="text-[10px] text-slate-400 font-mono">PT</span>
      </button>

      <button type="button" class="lang-option-btn w-full text-left px-3 py-2 text-xs font-semibold rounded-xl hover:bg-slate-100 flex items-center justify-between transition-colors text-slate-800 cursor-pointer" data-lang="tr">
        <span class="flex items-center gap-2"><span>🇹🇷</span> <span>Türkçe</span></span>
        <span class="text-[10px] text-slate-400 font-mono">TR</span>
      </button>

      <button type="button" class="lang-option-btn w-full text-left px-3 py-2 text-xs font-semibold rounded-xl hover:bg-slate-100 flex items-center justify-between transition-colors text-slate-800 cursor-pointer" data-lang="ru">
        <span class="flex items-center gap-2"><span>🇷🇺</span> <span>Русский</span></span>
        <span class="text-[10px] text-slate-400 font-mono">RU</span>
      </button>
    </div>

    <!-- Hidden Native Google Translate Mount Point -->
    <div id="google_translate_element" style="display:none;"></div>
  </div>
</div>

<script is:inline>
  // Immediately set googtrans cookie to German before Google script initializes
  (function ensureGermanDefault() {
    const cookies = document.cookie.split(';');
    let hasGoogtrans = false;
    for (let c of cookies) {
      if (c.trim().startsWith('googtrans=')) {
        hasGoogtrans = true;
        break;
      }
    }
    if (!hasGoogtrans) {
      const host = window.location.hostname;
      document.cookie = "googtrans=/en/de; path=/;";
      if (host && host !== 'localhost') {
        document.cookie = "googtrans=/en/de; path=/; domain=." + host + ";";
      }
    }
  })();

  // Function to initialize Google Translate element cleanly with German target
  window.googleTranslateElementInit = function() {
    new google.translate.TranslateElement({
      pageLanguage: 'en',
      includedLanguages: 'de,en,es,fr,it,pt,tr,ru',
      autoDisplay: false,
      layout: google.translate.TranslateElement.InlineLayout.SIMPLE
    }, 'google_translate_element');

    // Auto-trigger German if not already translated
    setTimeout(() => {
      const select = document.querySelector('#google_translate_element select');
      if (select && select.value !== 'de' && !document.cookie.includes('googtrans=/en/en')) {
        select.value = 'de';
        select.dispatchEvent(new Event('change'));
      }
    }, 500);
  };

  function setLanguage(langCode) {
    // 1. Set google translate cookie (/en/code)
    const domain = window.location.hostname;
    document.cookie = `googtrans=/en/${langCode}; path=/;`;
    if (domain && domain !== 'localhost') {
      document.cookie = `googtrans=/en/${langCode}; path=/; domain=.${domain};`;
    }

    // 2. Also update select box inside google translate iframe/element if loaded
    const select = document.querySelector('#google_translate_element select');
    if (select) {
      select.value = langCode;
      select.dispatchEvent(new Event('change'));
    }

    // 3. Update UI badge
    const badge = document.getElementById('current-lang-code');
    if (badge) {
      badge.textContent = langCode === 'zh-CN' ? 'ZH' : langCode.toUpperCase();
    }

    // 4. Save preference in localStorage
    try {
      localStorage.setItem('user_selected_lang', langCode);
    } catch(e) {}

    // Reload page to apply clean translation across all dynamic routes
    window.location.reload();
  }

  // Load Google Translate API asynchronously
  (function loadGoogleTranslateScript() {
    if (document.getElementById('google-translate-script')) return;
    const script = document.createElement('script');
    script.id = 'google-translate-script';
    script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
    script.async = true;
    document.head.appendChild(script);
  })();

  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('lang-menu-btn');
    const menu = document.getElementById('lang-dropdown-menu');
    const chevron = document.getElementById('lang-chevron');

    // Read stored or cookie language (Default to 'de' for Germany target)
    const cookies = document.cookie.split(';');
    let current = 'de';
    for (let c of cookies) {
      c = c.trim();
      if (c.startsWith('googtrans=')) {
        const val = c.split('=')[1];
        if (val) {
          const parts = val.split('/');
          if (parts.length >= 3 && parts[2]) {
            current = parts[2];
          }
        }
      }
    }

    const badge = document.getElementById('current-lang-code');
    if (badge) {
      badge.textContent = current === 'zh-CN' ? 'ZH' : current.toUpperCase();
    }

    // Toggle dropdown
    if (btn && menu) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = menu.classList.contains('hidden');
        if (isHidden) {
          menu.classList.remove('hidden');
          chevron?.classList.add('rotate-180');
        } else {
          menu.classList.add('hidden');
          chevron?.classList.remove('rotate-180');
        }
      });

      // Close on outside click
      document.addEventListener('click', (e) => {
        if (!menu.contains(e.target) && !btn.contains(e.target)) {
          menu.classList.add('hidden');
          chevron?.classList.remove('rotate-180');
        }
      });
    }

    // Attach click listeners to language buttons
    document.querySelectorAll('.lang-option-btn').forEach((optBtn) => {
      optBtn.addEventListener('click', () => {
        const code = optBtn.getAttribute('data-lang');
        if (code) {
          setLanguage(code);
        }
      });
    });
  });
</script>

<style is:global>
  /* Suppress Google Translate banner and unwanted top gap */
  .goog-te-banner-frame.skiptranslate,
  .goog-te-banner-frame,
  .skiptranslate iframe {
    display: none !important;
  }
  body {
    top: 0px !important;
  }
  #goog-gt-tt, .goog-te-balloon-frame {
    display: none !important;
  }
  .goog-text-highlight {
    background: none !important;
    box-shadow: none !important;
  }
</style>
