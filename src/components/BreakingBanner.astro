---
interface Props {
  headline?: string;
  slug?: string;
}

const {
  headline = "Bitcoin überschreitet 89.000 $-Marke bei Rekord-ETF-Zuflüssen",
  slug = "bitcoin-kurs-anlageratgeber-analyse-2026"
} = Astro.props;
---

<div class="bg-cyan-500/10 border-y border-cyan-500/20 py-2 px-4">
  <div class="max-w-7xl mx-auto flex items-center gap-3 text-xs">
    <div class="flex items-center gap-1.5 bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-black px-2 py-0.5 rounded text-[10px] uppercase tracking-wider shrink-0 shadow-xs">
      <span>●</span>
      <span>Eilmeldung</span>
    </div>
    
    <a href={`/nachrichten/${slug}`} class="text-slate-800 hover:text-cyan-700 font-semibold truncate transition-colors flex-1">
      {headline}
    </a>

    <a href={`/nachrichten/${slug}`} class="hidden sm:inline-flex items-center gap-1 text-cyan-700 hover:text-cyan-900 font-bold shrink-0">
      <span>Artikel lesen</span>
      <span>→</span>
    </a>
  </div>
</div>
