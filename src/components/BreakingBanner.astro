---
interface Props {
  headline?: string;
  slug?: string;
}

const {
  headline = "Bitcoin hits record $89,000 as institutional ETF inflows cross $3.2B in historic weekly record",
  slug = "bitcoin-hits-89k-institutional-inflows"
} = Astro.props;
---

<div class="bg-cyan-500/10 border-y border-cyan-500/20 py-2 px-4">
  <div class="max-w-7xl mx-auto flex items-center gap-3 text-xs">
    <div class="flex items-center gap-1.5 bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-black px-2 py-0.5 rounded text-[10px] uppercase tracking-wider shrink-0 shadow-xs">
      <span>●</span>
      <span>Breaking News</span>
    </div>
    
    <a href={`/news/${slug}`} class="text-slate-800 hover:text-cyan-700 font-semibold truncate transition-colors flex-1">
      {headline}
    </a>

    <a href={`/news/${slug}`} class="hidden sm:inline-flex items-center gap-1 text-cyan-700 hover:text-cyan-900 font-bold shrink-0">
      <span>Read Story</span>
      <span>→</span>
    </a>
  </div>
</div>
