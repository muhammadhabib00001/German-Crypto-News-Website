---
import { CATEGORY_LIST } from '../data/categories';

const mainCategories = CATEGORY_LIST.slice(0, 8);
const moreCategories = CATEGORY_LIST.slice(8);
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-6">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-amber-500 via-amber-600 to-orange-600 flex items-center justify-center font-black text-white text-xl shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform">
            ⚡
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-extrabold tracking-tight text-slate-900 flex items-center gap-1">
              Crypto<span class="text-amber-600">Pulse</span>
            </span>
            <span class="text-[9px] uppercase tracking-widest text-slate-500 font-semibold -mt-1">
              Financial Intelligence
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Categories -->
        <nav class="hidden xl:flex items-center gap-1 pl-4 border-l border-slate-200">
          <a
            href="/token-launches"
            class="px-3 py-1.5 text-xs font-bold text-amber-700 bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/20 rounded-md transition-colors inline-flex items-center gap-1.5 mr-1 shadow-2xs"
          >
            <span>🚀</span>
            <span>Token Launches</span>
          </a>

          {mainCategories.map((cat) => (
            <a
              href={`/category/${cat.slug}`}
              class="px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-950 hover:bg-slate-100 rounded-md transition-colors"
            >
              {cat.name}
            </a>
          ))}
          
          <!-- Dropdown for more categories -->
          <div class="relative group">
            <button class="px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-950 hover:bg-slate-100 rounded-md transition-colors inline-flex items-center gap-1 cursor-pointer">
              More
              <svg class="w-3.5 h-3.5 opacity-70 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-0 mt-1 w-56 rounded-xl bg-white border border-slate-200 shadow-xl p-2 hidden group-hover:block transition-all z-50">
              <div class="grid grid-cols-1 gap-1">
                {moreCategories.map((cat) => (
                  <a
                    href={`/category/${cat.slug}`}
                    class="px-3 py-2 text-xs font-medium text-slate-700 hover:text-slate-950 hover:bg-slate-50 rounded-lg transition-colors flex items-center justify-between"
                  >
                    <span>{cat.name}</span>
                    <span class="text-[10px] text-slate-400">Explore</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </nav>
      </div>

      <!-- Right Header Actions (Search, Newsletter, Mobile Hamburger) -->
      <div class="flex items-center gap-3">
        <!-- Instant Search Trigger Button -->
        <button
          id="search-btn"
          type="button"
          class="flex items-center gap-2 px-3 py-1.5 text-xs text-slate-600 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-lg transition-colors group cursor-pointer"
          aria-label="Search articles"
        >
          <svg class="w-4 h-4 text-slate-500 group-hover:text-amber-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden md:inline">Search stories...</span>
          <kbd class="hidden md:inline-block px-1.5 py-0.5 text-[10px] font-mono bg-white border border-slate-200 text-slate-500 rounded">⌘K</kbd>
        </button>

        <!-- Newsletter Quick Link -->
        <a
          href="#newsletter"
          class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-bold text-slate-900 bg-amber-400 hover:bg-amber-300 rounded-lg shadow-sm shadow-amber-400/20 transition-all"
        >
          <span>Subscribe</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="xl:hidden p-2 text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-lg cursor-pointer transition-colors"
          aria-label="Open navigation menu"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden xl:hidden bg-white border-b border-slate-200 px-4 pt-3 pb-6 max-h-[80vh] overflow-y-auto shadow-lg">
    <div class="mb-4 pb-3 border-b border-slate-200">
      <a
        href="/token-launches"
        class="flex items-center justify-between p-3 bg-amber-500/10 border border-amber-500/20 rounded-xl text-xs font-bold text-amber-800"
      >
        <span class="flex items-center gap-2">
          <span>🚀</span>
          <span>Upcoming Token Launches & Presales</span>
        </span>
        <span>→</span>
      </a>
    </div>

    <div class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 px-2">Categories</div>
    <div class="grid grid-cols-2 gap-2 mb-4">
      {CATEGORY_LIST.map((cat) => (
        <a
          href={`/category/${cat.slug}`}
          class="px-3 py-2 text-xs font-medium text-slate-700 hover:text-slate-950 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg transition-colors"
        >
          {cat.name}
        </a>
      ))}
    </div>
    
    <div class="border-t border-slate-200 pt-4 flex flex-col gap-2">
      <a href="/authors" class="px-3 py-1.5 text-xs text-slate-600 hover:text-slate-900">Our Editorial Team & Authors</a>
      <a href="/editorial-policy" class="px-3 py-1.5 text-xs text-slate-600 hover:text-slate-900">Editorial Guidelines</a>
      <a href="/about" class="px-3 py-1.5 text-xs text-slate-600 hover:text-slate-900">About CryptoPulse</a>
      <a href="/contact" class="px-3 py-1.5 text-xs text-slate-600 hover:text-slate-900">Contact & Press Office</a>
    </div>
  </div>
</header>

<script is:inline>
  const searchBtn = document.getElementById('search-btn');
  const searchModal = document.getElementById('search-modal');
  if (searchBtn && searchModal) {
    searchBtn.addEventListener('click', () => {
      searchModal.classList.remove('hidden');
      const input = document.getElementById('search-input');
      if (input) input.focus();
    });
  }

  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
