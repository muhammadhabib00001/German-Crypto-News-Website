---
import { CATEGORY_LIST } from '../data/categories';

// Curated primary topics for prominent navbar display
const primaryNav = [
  { name: 'Bitcoin', slug: 'bitcoin', icon: '₿' },
  { name: 'Ethereum', slug: 'ethereum', icon: 'Ξ' },
  { name: 'DeFi', slug: 'defi', icon: '⚡' },
  { name: 'Altcoins', slug: 'altcoins', icon: '💎' },
  { name: 'Markets', slug: 'crypto-markets', icon: '📈' },
  { name: 'Regulation', slug: 'crypto-regulation', icon: '⚖️' },
  { name: 'Web3 & AI', slug: 'web3', icon: '🌐' }
];

// Group remaining categories cleanly for dropdown
const moreCategories = CATEGORY_LIST.filter(c => !['bitcoin', 'ethereum', 'defi', 'altcoins', 'crypto-markets', 'crypto-regulation', 'web3'].includes(c.slug));
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-3">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-4 lg:gap-6 shrink-0">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-500 via-amber-600 to-orange-600 flex items-center justify-center font-black text-white text-lg shadow-md shadow-amber-500/20 group-hover:scale-105 transition-transform">
            ⚡
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-black tracking-tight text-black flex items-center gap-0.5">
              Crypto<span class="text-amber-600">Pulse</span>
            </span>
            <span class="text-[9px] uppercase tracking-widest text-slate-500 font-bold -mt-1">
              Financial Intelligence
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Bar -->
        <nav class="hidden lg:flex items-center gap-1 pl-4 border-l border-slate-200">
          
          <!-- Prominent Token Launches Tab -->
          <a
            href="/token-launches"
            class="px-3 py-1.5 text-xs font-black text-amber-900 bg-amber-400/20 hover:bg-amber-400/30 border border-amber-500/30 rounded-lg transition-all inline-flex items-center gap-1.5 mr-1 shadow-2xs"
          >
            <span class="text-sm">🚀</span>
            <span>Token Launches</span>
            <span class="text-[9px] uppercase tracking-wider bg-amber-500 text-slate-950 px-1 py-0.2 rounded font-black">Live</span>
          </a>

          <!-- Primary Category Links -->
          {primaryNav.map((item) => (
            <a
              href={`/category/${item.slug}`}
              class="px-2.5 py-1.5 text-xs font-bold text-slate-700 hover:text-black hover:bg-slate-100 rounded-lg transition-colors inline-flex items-center gap-1"
            >
              <span class="text-[11px] opacity-70">{item.icon}</span>
              <span>{item.name}</span>
            </a>
          ))}
          
          <!-- Explore Categories Megamenu Dropdown -->
          <div class="relative group">
            <button
              type="button"
              class="px-2.5 py-1.5 text-xs font-bold text-slate-700 hover:text-black hover:bg-slate-100 rounded-lg transition-colors inline-flex items-center gap-1 cursor-pointer"
              aria-expanded="false"
              aria-haspopup="true"
            >
              <span>Explore</span>
              <svg class="w-3.5 h-3.5 text-slate-500 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Dropdown Menu Box -->
            <div class="absolute left-0 mt-1 w-72 rounded-2xl bg-white border border-slate-200 shadow-2xl p-3 hidden group-hover:block transition-all z-50 animate-in fade-in slide-in-from-top-1 duration-150">
              <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-2.5 py-1">
                More Sectors & Niches
              </div>
              <div class="grid grid-cols-1 gap-0.5 mt-1">
                {moreCategories.map((cat) => (
                  <a
                    href={`/category/${cat.slug}`}
                    class="px-3 py-2 text-xs font-semibold text-slate-800 hover:text-black hover:bg-slate-50 rounded-xl transition-colors flex items-center justify-between group/sub"
                  >
                    <span>{cat.name}</span>
                    <span class="text-[10px] text-slate-400 group-hover/sub:text-amber-600 font-bold transition-colors">→</span>
                  </a>
                ))}
              </div>

              <!-- Quick Editorial Links inside Dropdown -->
              <div class="border-t border-slate-100 mt-2 pt-2 grid grid-cols-2 gap-1 text-[11px] text-slate-500 font-medium px-1">
                <a href="/authors" class="px-2 py-1 hover:text-black hover:bg-slate-50 rounded">Authors</a>
                <a href="/editorial-policy" class="px-2 py-1 hover:text-black hover:bg-slate-50 rounded">Editorial</a>
                <a href="/about" class="px-2 py-1 hover:text-black hover:bg-slate-50 rounded">About Us</a>
                <a href="/contact" class="px-2 py-1 hover:text-black hover:bg-slate-50 rounded">Contact</a>
              </div>
            </div>
          </div>
        </nav>
      </div>

      <!-- Right Header Actions (Search, Newsletter, Mobile Toggle) -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Instant Search Trigger Button -->
        <button
          id="search-btn"
          type="button"
          class="flex items-center gap-2 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-xl transition-colors group cursor-pointer"
          aria-label="Search articles"
        >
          <svg class="w-4 h-4 text-slate-500 group-hover:text-amber-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden md:inline">Search...</span>
          <kbd class="hidden md:inline-block px-1.5 py-0.5 text-[10px] font-mono bg-white border border-slate-300 text-slate-600 rounded">⌘K</kbd>
        </button>

        <!-- Newsletter CTA -->
        <a
          href="#newsletter"
          class="hidden sm:inline-flex items-center gap-1 px-3.5 py-1.5 text-xs font-black text-slate-950 bg-amber-400 hover:bg-amber-300 rounded-xl shadow-xs transition-all cursor-pointer"
        >
          <span>Subscribe</span>
        </a>

        <!-- Mobile Menu Hamburger Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden p-2 text-slate-700 hover:text-black bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-xl cursor-pointer transition-colors"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu (Responsive & Organized) -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-slate-200 px-4 pt-3 pb-6 max-h-[85vh] overflow-y-auto shadow-xl animate-in slide-in-from-top-2 duration-150">
    
    <!-- Token Launches Feature Tile -->
    <div class="mb-4 pb-3 border-b border-slate-200">
      <a
        href="/token-launches"
        class="flex items-center justify-between p-3.5 bg-gradient-to-r from-amber-500/15 to-amber-500/5 border border-amber-500/30 rounded-2xl text-xs font-black text-amber-900 shadow-2xs"
      >
        <span class="flex items-center gap-2">
          <span class="text-base">🚀</span>
          <span>Upcoming Token Launches & Presales</span>
        </span>
        <span class="px-2 py-0.5 bg-amber-500 text-slate-950 rounded-md text-[10px] uppercase tracking-wider font-extrabold">Live</span>
      </a>
    </div>

    <!-- Main Navigation Categories Grid -->
    <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2 px-1">
      Coverage Sectors
    </div>
    <div class="grid grid-cols-2 gap-2 mb-5">
      {CATEGORY_LIST.map((cat) => (
        <a
          href={`/category/${cat.slug}`}
          class="px-3 py-2 text-xs font-bold text-slate-800 hover:text-black bg-slate-50 hover:bg-slate-100 border border-slate-200/80 rounded-xl transition-colors flex items-center justify-between"
        >
          <span>{cat.name}</span>
          <span class="text-slate-400 text-[10px]">→</span>
        </a>
      ))}
    </div>
    
    <!-- Publication Info & Policies -->
    <div class="border-t border-slate-200 pt-3 flex flex-col gap-1 text-xs font-semibold text-slate-600">
      <a href="/authors" class="px-3 py-2 hover:bg-slate-50 rounded-lg hover:text-black">Our Authors & Analysts</a>
      <a href="/editorial-policy" class="px-3 py-2 hover:bg-slate-50 rounded-lg hover:text-black">Editorial Standards</a>
      <a href="/about" class="px-3 py-2 hover:bg-slate-50 rounded-lg hover:text-black">About CryptoPulse</a>
      <a href="/contact" class="px-3 py-2 hover:bg-slate-50 rounded-lg hover:text-black">Contact & PR Inquiries</a>
    </div>
  </div>
</header>

<script is:inline>
  const searchBtn = document.getElementById('search-btn');
  const searchModal = document.getElementById('search-modal');
  if (searchBtn && searchModal) {
    searchBtn.addEventListener('click', () => {
      searchModal.classList.remove('hidden');
      const input = document.getElementById('search-input');
      if (input) input.focus();
    });
  }

  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
