---
import { CATEGORY_LIST } from '../data/categories';
import LanguageSelector from './LanguageSelector.astro';

// Curated primary topics for clean, uncluttered navbar display across all desktop sizes
const primaryNav = [
  { name: 'Bitcoin', slug: 'bitcoin', icon: '₿', showOn: 'always' },
  { name: 'Ethereum', slug: 'ethereum', icon: 'Ξ', showOn: 'always' },
  { name: 'DeFi', slug: 'defi', icon: '⚡', showOn: 'always' },
  { name: 'Altcoins', slug: 'altcoins', icon: '💎', showOn: 'always' },
  { name: 'Markets', slug: 'crypto-markets', icon: '📈', showOn: 'xl' }
];

// All remaining sectors & niches are grouped cleanly for the Explore megamenu
const primarySlugs = ['bitcoin', 'ethereum', 'defi', 'altcoins', 'crypto-markets'];
const moreCategories = CATEGORY_LIST.filter(c => !primarySlugs.includes(c.slug));
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs w-full">
  <div class="max-w-[1400px] mx-auto px-2 sm:px-4 lg:px-6">
    <div class="flex items-center justify-between h-16 gap-1.5 sm:gap-3">
      
      <!-- Left Side: Brand Logo & Desktop Navigation -->
      <div class="flex items-center gap-2 xl:gap-4 shrink-0">
        <a href="/" class="flex items-center group py-1 shrink-0" aria-label="newskrypt Home">
          <img
            src="/logo.png"
            alt="newskrypt"
            class="h-8 sm:h-9 xl:h-10 w-auto object-contain transition-transform group-hover:scale-[1.02]"
            loading="eager"
          />
        </a>

        <!-- Desktop Navigation Bar -->
        <nav class="hidden lg:flex items-center gap-1 xl:gap-1.5 pl-2 xl:pl-4 border-l border-slate-200 shrink-0 notranslate skiptranslate">
          
          <!-- Prominent Token Launches Tab -->
          <a
            href="/token-launches"
            class="px-2.5 xl:px-3.5 py-1.5 text-xs font-black text-cyan-900 bg-cyan-500/15 hover:bg-cyan-500/25 border border-cyan-500/30 rounded-xl transition-all inline-flex items-center gap-1.5 shrink-0 shadow-2xs mr-1"
          >
            <span class="text-xs sm:text-sm">🚀</span>
            <span class="whitespace-nowrap">Token Launches</span>
            <span class="text-[9px] uppercase tracking-wider bg-gradient-to-r from-cyan-500 to-blue-600 text-white px-1.5 py-0.2 rounded font-black shadow-xs">Live</span>
          </a>

          <!-- Events Link -->
          <a
            href="/events"
            class="px-2.5 xl:px-3 py-1.5 text-xs font-bold text-slate-700 hover:text-black hover:bg-slate-100 rounded-xl transition-colors inline-flex items-center gap-1 whitespace-nowrap"
          >
            <span class="text-[11px] opacity-70">🗓️</span>
            <span>Events</span>
          </a>

          <!-- Primary Category Links -->
          {primaryNav.map((item) => (
            <a
              href={`/category/${item.slug}`}
              class={`px-2.5 xl:px-3 py-1.5 text-xs font-bold text-slate-700 hover:text-black hover:bg-slate-100 rounded-xl transition-colors items-center gap-1 whitespace-nowrap ${
                item.showOn === 'xl' ? 'hidden xl:inline-flex' : 'inline-flex'
              }`}
            >
              <span class="text-[11px] opacity-70">{item.icon}</span>
              <span>{item.name}</span>
            </a>
          ))}
          
          <!-- Explore Categories Megamenu Dropdown -->
          <div class="relative group shrink-0">
            <button
              type="button"
              class="px-2.5 xl:px-3 py-1.5 text-xs font-bold text-slate-700 hover:text-black hover:bg-slate-100 rounded-xl transition-colors inline-flex items-center gap-1 cursor-pointer whitespace-nowrap shrink-0"
              aria-expanded="false"
              aria-haspopup="true"
            >
              <span class="whitespace-nowrap">Explore</span>
              <svg class="w-3.5 h-3.5 text-slate-500 group-hover:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Dropdown Menu Box -->
            <div class="absolute left-0 mt-1 w-72 rounded-2xl bg-white border border-slate-200 shadow-2xl p-3 hidden group-hover:block transition-all z-50 animate-in fade-in slide-in-from-top-1 duration-150 max-h-[75vh] overflow-y-auto no-scrollbar">
              <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-2.5 py-1">
                More Sectors & Niches
              </div>
              <div class="grid grid-cols-1 gap-0.5 mt-1">
                {moreCategories.map((cat) => (
                  <a
                    href={`/category/${cat.slug}`}
                    class="px-3 py-2 text-xs font-semibold text-slate-800 hover:text-black hover:bg-slate-50 rounded-xl transition-colors flex items-center justify-between group/sub"
                  >
                    <span>{cat.name}</span>
                    <span class="text-[10px] text-slate-400 group-hover/sub:text-cyan-600 font-bold transition-colors">→</span>
                  </a>
                ))}
              </div>

              <!-- Quick Editorial Links inside Dropdown -->
              <div class="border-t border-slate-100 mt-2 pt-2 grid grid-cols-2 gap-1 text-[11px] text-slate-500 font-medium px-1">
                <a href="/authors" class="px-2 py-1 hover:text-black hover:bg-slate-50 rounded">Authors</a>
                <a href="/editorial-policy" class="px-2 py-1 hover:text-black hover:bg-slate-50 rounded">Editorial</a>
                <a href="/about" class="px-2 py-1 hover:text-black hover:bg-slate-50 rounded">About Us</a>
                <a href="/contact" class="px-2 py-1 hover:text-black hover:bg-slate-50 rounded">Contact</a>
              </div>
            </div>
          </div>
        </nav>
      </div>

      <!-- Right Side Actions (Language, Instant Search, Mobile Menu Button) -->
      <div class="flex items-center gap-1.5 sm:gap-2 lg:gap-3 shrink-0 ml-auto">
        <!-- Multilingual Reader Selector -->
        <div class="shrink-0">
          <LanguageSelector />
        </div>

        <!-- Instant Search Trigger Button -->
        <button
          id="search-btn"
          type="button"
          class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-xl transition-colors group cursor-pointer shrink-0"
          aria-label="Search articles"
        >
          <svg class="w-4 h-4 text-slate-500 group-hover:text-cyan-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden sm:inline">Search...</span>
          <kbd class="hidden xl:inline-block px-1.5 py-0.5 text-[10px] font-mono bg-white border border-slate-300 text-slate-600 rounded">⌘K</kbd>
        </button>

        <!-- Mobile Menu Hamburger Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden p-2 text-slate-700 hover:text-black bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-xl cursor-pointer transition-colors shrink-0"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu (Responsive & Organized) -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-slate-200 px-4 pt-3 pb-6 max-h-[85vh] overflow-y-auto shadow-xl animate-in slide-in-from-top-2 duration-150">
    
    <!-- Token Launches Feature Tile -->
    <div class="mb-4 pb-3 border-b border-slate-200">
      <a
        href="/token-launches"
        class="flex items-center justify-between p-3.5 bg-gradient-to-r from-cyan-500/15 via-blue-500/10 to-violet-500/10 border border-cyan-500/30 rounded-2xl text-xs font-black text-cyan-950 shadow-2xs"
      >
        <span class="flex items-center gap-2">
          <span class="text-base">🚀</span>
          <span>Upcoming Token Launches & Presales</span>
        </span>
        <span class="px-2 py-0.5 bg-gradient-to-r from-cyan-500 to-blue-600 text-white rounded-md text-[10px] uppercase tracking-wider font-extrabold">Live</span>
      </a>
    </div>

    <!-- Main Navigation Categories Grid -->
    <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2 px-1">
      Coverage Sectors
    </div>
    <div class="grid grid-cols-2 gap-2 mb-5">
      {CATEGORY_LIST.map((cat) => (
        <a
          href={`/category/${cat.slug}`}
          class="px-3 py-2 text-xs font-bold text-slate-800 hover:text-black bg-slate-50 hover:bg-slate-100 border border-slate-200/80 rounded-xl transition-colors flex items-center justify-between"
        >
          <span>{cat.name}</span>
          <span class="text-slate-400 text-[10px]">→</span>
        </a>
      ))}
    </div>
    
    <!-- Publication Info & Policies -->
    <div class="border-t border-slate-200 pt-3 flex flex-col gap-1 text-xs font-semibold text-slate-600">
      <a href="/authors" class="px-3 py-2 hover:bg-slate-50 rounded-lg hover:text-black">Our Authors & Analysts</a>
      <a href="/editorial-policy" class="px-3 py-2 hover:bg-slate-50 rounded-lg hover:text-black">Editorial Standards</a>
      <a href="/about" class="px-3 py-2 hover:bg-slate-50 rounded-lg hover:text-black">About newskrypt</a>
      <a href="/contact" class="px-3 py-2 hover:bg-slate-50 rounded-lg hover:text-black">Contact & PR Inquiries</a>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchBtn = document.getElementById('search-btn');
    if (searchBtn) {
      searchBtn.addEventListener('click', (e) => {
        e.preventDefault();
        if (typeof window.openSearchModal === 'function') {
          window.openSearchModal();
        } else {
          const modal = document.getElementById('search-modal');
          if (modal) {
            modal.classList.remove('hidden');
            modal.style.display = 'flex';
            const input = document.getElementById('search-input');
            if (input) input.focus();
          }
        }
      });
    }

    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileBtn && mobileMenu) {
      mobileBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  });
</script>
