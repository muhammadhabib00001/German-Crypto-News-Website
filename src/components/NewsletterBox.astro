---
---

<div id="newsletter" class="bg-gradient-to-br from-cyan-500/10 via-white to-violet-500/10 border border-cyan-500/20 rounded-2xl p-6 sm:p-8 relative overflow-hidden my-12 shadow-xs">
  <div class="absolute -right-8 -bottom-8 w-48 h-48 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-2xl">
    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-800 text-xs font-bold mb-3">
      <span>✉</span>
      <span>newskrypt Institutional Dispatch</span>
    </div>

    <h3 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight mb-2">
      Daily Institutional Alpha & Macro Crypto Briefing
    </h3>

    <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-6">
      Join 45,000+ portfolio managers, crypto founders, and hedge fund traders receiving our curated morning breakdown of on-chain metrics, ETF flows, and regulatory alerts.
    </p>

    <form class="flex flex-col sm:flex-row gap-2.5" onsubmit="event.preventDefault(); alert('Thank you for subscribing to newskrypt Daily Dispatch!');">
      <input
        type="email"
        required
        placeholder="Enter your professional work email..."
        class="flex-1 px-4 py-3 bg-white border border-slate-300 rounded-xl text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-cyan-500 transition-colors shadow-xs"
      />
      <button
        type="submit"
        class="px-6 py-3 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs sm:text-sm rounded-xl shadow-md shadow-cyan-500/20 transition-all cursor-pointer whitespace-nowrap"
      >
        Subscribe Free
      </button>
    </form>

    <div class="flex items-center gap-4 text-[11px] text-slate-500 mt-3">
      <span>✓ Free morning edition</span>
      <span>✓ No spam ever</span>
      <span>✓ 1-click unsubscribe anytime</span>
    </div>
  </div>
</div>
