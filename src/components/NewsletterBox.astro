---
---

<div id="newsletter" class="bg-gradient-to-br from-slate-900 via-slate-900 to-amber-950/30 border border-amber-500/20 rounded-2xl p-6 sm:p-8 relative overflow-hidden my-12">
  <div class="absolute -right-8 -bottom-8 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-2xl">
    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-amber-400/10 border border-amber-400/20 text-amber-400 text-xs font-bold mb-3">
      <span>✉</span>
      <span>CryptoPulse Institutional Dispatch</span>
    </div>

    <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight mb-2">
      Daily Institutional Alpha & Macro Crypto Briefing
    </h3>

    <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
      Join 45,000+ portfolio managers, crypto founders, and hedge fund traders receiving our curated morning breakdown of on-chain metrics, ETF flows, and regulatory alerts.
    </p>

    <form class="flex flex-col sm:flex-row gap-2.5" onsubmit="event.preventDefault(); alert('Thank you for subscribing to CryptoPulse Daily Dispatch!');">
      <input
        type="email"
        required
        placeholder="Enter your professional work email..."
        class="flex-1 px-4 py-3 bg-slate-950/80 border border-slate-700 rounded-xl text-xs sm:text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition-colors"
      />
      <button
        type="submit"
        class="px-6 py-3 bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs sm:text-sm rounded-xl shadow-lg shadow-amber-400/20 transition-all cursor-pointer whitespace-nowrap"
      >
        Subscribe Free
      </button>
    </form>

    <div class="flex items-center gap-4 text-[11px] text-slate-400 mt-3">
      <span>✓ Free morning edition</span>
      <span>✓ No spam ever</span>
      <span>✓ 1-click unsubscribe anytime</span>
    </div>
  </div>
</div>
