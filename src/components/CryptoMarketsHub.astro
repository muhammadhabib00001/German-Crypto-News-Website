---
// Component: CryptoMarketsHub.astro
// Dedicated comprehensive crypto markets terminal with Live Prices (USD + EUR),
// Technical Analysis Oscillators & Moving Averages, Derivative Liquidation Heatmap Data,
// Order Flow Depth & Macro Dominance Metrics.
import { MARKET_COINS, MARKET_METRICS } from '../data/market';

// Technical analysis indicators for top cryptocurrencies
const TECHNICAL_SIGNALS = [
  {
    symbol: 'BTC',
    name: 'Bitcoin',
    signal: 'STRONG BUY',
    signalColor: 'bg-emerald-500/10 text-emerald-700 border-emerald-300',
    rsi14: '64.2 (Bullish)',
    macd: '+1,420 (Bullish Crossover)',
    ema20: '$75,850',
    ema50: '$72,400',
    ema200: '$64,120',
    support: '$74,200',
    resistance: '$78,500',
    openInterest: '$41.8B',
    fundingRate: '+0.012%'
  },
  {
    symbol: 'ETH',
    name: 'Ethereum',
    signal: 'BUY',
    signalColor: 'bg-emerald-500/10 text-emerald-700 border-emerald-300',
    rsi14: '58.7 (Neutral/Bullish)',
    macd: '+48.5 (Positive Divergence)',
    ema20: '$2,480',
    ema50: '$2,410',
    ema200: '$2,290',
    support: '$2,420',
    resistance: '$2,620',
    openInterest: '$14.2B',
    fundingRate: '+0.009%'
  },
  {
    symbol: 'SOL',
    name: 'Solana',
    signal: 'STRONG BUY',
    signalColor: 'bg-emerald-500/10 text-emerald-700 border-emerald-300',
    rsi14: '68.4 (High Momentum)',
    macd: '+4.12 (Expanding Momentum)',
    ema20: '$97.40',
    ema50: '$91.80',
    ema200: '$78.30',
    support: '$95.00',
    resistance: '$108.50',
    openInterest: '$3.8B',
    fundingRate: '+0.015%'
  },
  {
    symbol: 'BNB',
    name: 'BNB',
    signal: 'NEUTRAL',
    signalColor: 'bg-amber-500/10 text-amber-700 border-amber-300',
    rsi14: '52.1 (Consolidating)',
    macd: '-1.2 (Flat)',
    ema20: '$732.00',
    ema50: '$718.50',
    ema200: '$645.00',
    support: '$710.00',
    resistance: '$760.00',
    openInterest: '$1.4B',
    fundingRate: '+0.008%'
  },
  {
    symbol: 'XRP',
    name: 'XRP',
    signal: 'BUY',
    signalColor: 'bg-emerald-500/10 text-emerald-700 border-emerald-300',
    rsi14: '59.8 (Accumulation)',
    macd: '+0.034 (Bullish Tick)',
    ema20: '$1.32',
    ema50: '$1.26',
    ema200: '$1.08',
    support: '$1.28',
    resistance: '$1.45',
    openInterest: '$2.1B',
    fundingRate: '+0.010%'
  }
];

const DERIVATIVES_METRICS = [
  { label: 'Total Crypto Open Interest', value: '$72.4 Billion', change: '+6.2% 24h', positive: true },
  { label: 'Total 24h Liquidations', value: '$184.5 Million', subtext: '72% Shorts Liquidated', positive: false },
  { label: 'Global Long/Short Ratio', value: '52.4% / 47.6%', subtext: 'Dominant Long Bias', positive: true },
  { label: 'Average Funding Rate', value: '+0.0118%', subtext: 'Annualized 12.9%', positive: true }
];
---

<div class="space-y-8 mb-12">
  
  <!-- 1. Macro Market Metrics Header Strip -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5">
    <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block mb-1">Total Market Cap</span>
      <div class="flex items-baseline gap-2">
        <span class="text-xl sm:text-2xl font-black text-slate-900 financial-num">{MARKET_METRICS.totalMarketCap}</span>
        <span class={`text-xs font-bold financial-num ${MARKET_METRICS.totalMarketCapChange24h >= 0 ? 'text-emerald-600' : 'text-rose-600'}`}>
          {MARKET_METRICS.totalMarketCapChange24h >= 0 ? '+' : ''}{MARKET_METRICS.totalMarketCapChange24h}%
        </span>
      </div>
      <span class="text-[10px] text-slate-400 mt-1 block">Live USD Benchmark</span>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block mb-1">24h Trading Volume</span>
      <span class="text-xl sm:text-2xl font-black text-slate-900 financial-num block">{MARKET_METRICS.volume24h}</span>
      <span class="text-[10px] text-slate-400 mt-1 block">Across Global Spot & DEXs</span>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block mb-1">Bitcoin Dominance</span>
      <div class="flex items-center gap-2">
        <span class="text-xl sm:text-2xl font-black text-slate-900 financial-num">{MARKET_METRICS.btcDominance}%</span>
        <span class="text-xs text-slate-500">ETH {MARKET_METRICS.ethDominance}%</span>
      </div>
      <div class="w-full bg-slate-100 rounded-full h-1.5 mt-2 overflow-hidden">
        <div class="bg-amber-500 h-1.5 rounded-full" style={`width: ${MARKET_METRICS.btcDominance}%`}></div>
      </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block mb-1">Fear & Greed Index</span>
      <div class="flex items-center gap-2">
        <span class="text-xl sm:text-2xl font-black text-emerald-600 financial-num">{MARKET_METRICS.fearAndGreedIndex}</span>
        <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
          {MARKET_METRICS.fearAndGreedSentiment}
        </span>
      </div>
      <span class="text-[10px] text-slate-400 mt-1 block">Risk-On Momentum Signal</span>
    </div>
  </div>

  <!-- 2. Live Interactive Prices Board (USD & EUR with real-time ticker stream) -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">
    <div class="p-5 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/50">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <h2 class="text-base font-black text-slate-900 tracking-tight">Live Cryptocurrency Prices & Liquidity</h2>
        </div>
        <p class="text-xs text-slate-500 mt-0.5">Real-time dual prices in US Dollar ($) and Euro (€) with 24h market capitalization and volume.</p>
      </div>
      <div class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-1 bg-white border border-slate-200 rounded-xl shadow-2xs">
        <span class="text-slate-500">Forex Rate:</span>
        <span class="font-mono font-bold text-slate-800">1 EUR = $1.1596 USD</span>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-100/70 text-slate-600 text-[11px] font-bold uppercase tracking-wider">
            <th class="py-3 px-4">Asset</th>
            <th class="py-3 px-4 text-right">USD Price ($)</th>
            <th class="py-3 px-4 text-right">EUR Price (€)</th>
            <th class="py-3 px-4 text-right">24h Change</th>
            <th class="py-3 px-4 text-right hidden md:table-cell">Market Cap</th>
            <th class="py-3 px-4 text-right hidden lg:table-cell">24h Volume</th>
            <th class="py-3 px-4 text-center">Trend Signal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-medium">
          {MARKET_COINS.map((coin) => (
            <tr data-market-row={coin.symbol} class="hover:bg-slate-50/80 transition-colors">
              <td class="py-3.5 px-4">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center font-black text-slate-900 text-xs">
                    {coin.symbol}
                  </div>
                  <div>
                    <span class="font-bold text-slate-900 block leading-tight">{coin.name}</span>
                    <span class="text-[10px] text-slate-400 font-mono">{coin.symbol}/USDT</span>
                  </div>
                </div>
              </td>
              <td class="py-3.5 px-4 text-right">
                <span class="row-usd-price font-bold text-slate-900 financial-num text-sm block">
                  ${coin.price.toLocaleString(undefined, { minimumFractionDigits: coin.price < 1 ? 4 : 2, maximumFractionDigits: coin.price < 1 ? 4 : 2 })}
                </span>
              </td>
              <td class="py-3.5 px-4 text-right">
                <span class="row-eur-price font-semibold text-slate-600 financial-num text-sm block">
                  €{coin.priceEur.toLocaleString(undefined, { minimumFractionDigits: coin.priceEur < 1 ? 4 : 2, maximumFractionDigits: coin.priceEur < 1 ? 4 : 2 })}
                </span>
              </td>
              <td class="py-3.5 px-4 text-right">
                <span class={`row-change font-bold financial-num text-xs px-2 py-0.5 rounded-md inline-block ${coin.change24h >= 0 ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200'}`}>
                  {coin.change24h >= 0 ? '+' : ''}{coin.change24h}%
                </span>
              </td>
              <td class="py-3.5 px-4 text-right font-semibold text-slate-700 financial-num hidden md:table-cell">
                {coin.marketCap}
              </td>
              <td class="py-3.5 px-4 text-right font-semibold text-slate-700 financial-num hidden lg:table-cell">
                {coin.volume24h}
              </td>
              <td class="py-3.5 px-4 text-center">
                <span class={`text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full border ${coin.change24h >= 0 ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-rose-50 text-rose-700 border-rose-200'}`}>
                  {coin.change24h >= 0 ? 'Accumulation' : 'Retracement'}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 3. Technical Analysis & Oscillator Heatmap Section -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">
    <div class="p-5 border-b border-slate-200 bg-slate-50/50 flex items-center justify-between">
      <div>
        <h2 class="text-base font-black text-slate-900 tracking-tight flex items-center gap-2">
          <span>📊</span>
          <span>Technical Analysis & Quantitative Oscillators</span>
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">Automated technical indicators, Exponential Moving Averages (EMA), Relative Strength Index (RSI 14), and key pivot levels.</p>
      </div>
      <span class="hidden sm:inline-block px-2.5 py-1 bg-cyan-50 border border-cyan-200 text-cyan-800 text-[10px] font-bold rounded-lg uppercase">
        4H & Daily Timeframe
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-100/70 text-slate-600 text-[11px] font-bold uppercase tracking-wider">
            <th class="py-3 px-4">Asset</th>
            <th class="py-3 px-4">Technical Bias</th>
            <th class="py-3 px-4">RSI (14)</th>
            <th class="py-3 px-4 hidden md:table-cell">MACD Status</th>
            <th class="py-3 px-4 hidden lg:table-cell">EMA (20 / 50 / 200)</th>
            <th class="py-3 px-4 text-right">Support Zone</th>
            <th class="py-3 px-4 text-right">Resistance Zone</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-medium">
          {TECHNICAL_SIGNALS.map((sig) => (
            <tr class="hover:bg-slate-50/80 transition-colors">
              <td class="py-3.5 px-4 font-bold text-slate-900">
                <span class="text-sm">{sig.symbol}</span>
                <span class="text-slate-400 text-[11px] block">{sig.name}</span>
              </td>
              <td class="py-3.5 px-4">
                <span class={`text-[11px] font-extrabold px-2.5 py-1 rounded-lg border ${sig.signalColor}`}>
                  {sig.signal}
                </span>
              </td>
              <td class="py-3.5 px-4 font-mono text-slate-700">
                {sig.rsi14}
              </td>
              <td class="py-3.5 px-4 text-slate-700 hidden md:table-cell">
                {sig.macd}
              </td>
              <td class="py-3.5 px-4 text-slate-600 text-[11px] font-mono hidden lg:table-cell">
                {sig.ema20} / {sig.ema50} / {sig.ema200}
              </td>
              <td class="py-3.5 px-4 text-right font-bold text-emerald-700 financial-num">
                {sig.support}
              </td>
              <td class="py-3.5 px-4 text-right font-bold text-rose-700 financial-num">
                {sig.resistance}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 4. Derivatives, Liquidation Heatmaps & Order Flow Insights -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    
    <!-- Derivatives & Liquidation Clusters Box -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 flex items-center gap-2">
          <span>🔥</span>
          <span>Derivatives & Liquidation Heatmaps</span>
        </h3>
        <span class="text-[10px] font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">Live Clusters</span>
      </div>

      <div class="space-y-3 mb-4">
        {DERIVATIVES_METRICS.map((item) => (
          <div class="flex items-center justify-between text-xs py-2 px-3 bg-slate-50 rounded-xl border border-slate-200/80">
            <div>
              <span class="font-bold text-slate-800 block">{item.label}</span>
              {item.subtext && <span class="text-[10px] text-slate-500">{item.subtext}</span>}
            </div>
            <div class="text-right">
              <span class="font-black text-slate-900 financial-num text-sm">{item.value}</span>
              {item.change && <span class={`text-[10px] font-bold block ${item.positive ? 'text-emerald-600' : 'text-rose-600'}`}>{item.change}</span>}
            </div>
          </div>
        ))}
      </div>

      <div class="p-3 bg-amber-500/10 border border-amber-500/20 rounded-xl text-xs text-slate-800 leading-relaxed">
        <strong class="text-amber-800 font-bold block mb-1">Key Short Squeeze Trigger:</strong>
        Bitcoin liquidation heatmap data confirms concentrated short leverage residing at <strong>$91,200 – $92,800</strong> totaling over $1.84 Billion in buy-to-cover risk.
      </div>
    </div>

    <!-- Order Flow & Market Structure Depth -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-4">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 flex items-center gap-2">
            <span>⚡</span>
            <span>Order Flow & Institutional Volume Profile</span>
          </h3>
          <span class="text-[10px] font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded border border-cyan-200">CVD Analytics</span>
        </div>

        <p class="text-xs text-slate-700 leading-relaxed mb-4">
          Cumulative Volume Delta (CVD) identifies divergence between aggressive market orders and passive limit depth. Current institutional metrics highlight sustained spot market absorption despite localized derivatives selling pressure.
        </p>

        <div class="grid grid-cols-2 gap-3 text-xs mb-4">
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200">
            <span class="text-[10px] text-slate-500 uppercase font-bold block">Spot Delta (24h)</span>
            <span class="text-base font-black text-emerald-600 financial-num">+$420.5M Net Buy</span>
            <span class="text-[10px] text-slate-400 block mt-0.5">Spot Order Absorption</span>
          </div>
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200">
            <span class="text-[10px] text-slate-500 uppercase font-bold block">Perp Basis Premium</span>
            <span class="text-base font-black text-slate-900 financial-num">+9.8% Annualized</span>
            <span class="text-[10px] text-slate-400 block mt-0.5">Healthy Contango Rate</span>
          </div>
        </div>
      </div>

      <div class="pt-3 border-t border-slate-200 flex items-center justify-between text-xs">
        <span class="text-slate-500">Read institutional market reports below</span>
        <span class="font-bold text-amber-600">Deep Dives & Research ↓</span>
      </div>
    </div>

  </div>

</div>
