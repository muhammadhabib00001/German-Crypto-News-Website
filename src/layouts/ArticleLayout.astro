---
import BaseLayout from './BaseLayout.astro';
import AdPlacement from '../components/AdPlacement.astro';
import { CATEGORIES } from '../data/categories';

interface Props {
  article: {
    slug: string;
    body: string;
    data: {
      title: string;
      metaTitle?: string;
      excerpt: string;
      metaDescription?: string;
      category: string;
      author: string;
      publishedDate: string;
      updatedDate?: string;
      readingTime: string;
      featuredImage: string;
      imageAlt: string;
      imageCaption?: string;
      tags: string[];
      keyHighlights: string[];
      faqs?: Array<{ question: string; answer: string }>;
      sources?: Array<{ name: string; url: string }>;
      contentType?: string;
    };
  };
  authorData: {
    name: string;
    role: string;
    avatar: string;
    bio: string;
    credentials?: string;
    social: {
      twitter?: string;
      linkedin?: string;
      email?: string;
    };
  };
  relatedArticles?: Array<{
    slug: string;
    data: any;
  }>;
  prevArticle?: {
    slug: string;
    data: any;
  };
  nextArticle?: {
    slug: string;
    data: any;
  };
  headings?: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { article, authorData, relatedArticles = [], prevArticle, nextArticle, headings = [] } = Astro.props;

const categoryMeta = CATEGORIES[article.data.category] || {
  name: article.data.category,
  badgeColor: 'bg-slate-800 text-slate-300'
};

const fullCanonical = `https://cryptopulse.news/news/${article.slug}`;

// Formatted dates
const pubDateStr = new Date(article.data.publishedDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const modDateStr = article.data.updatedDate
  ? new Date(article.data.updatedDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  : null;

// JSON-LD NewsArticle Structured Data
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": fullCanonical
  },
  "headline": article.data.title,
  "description": article.data.excerpt,
  "image": [article.data.featuredImage],
  "datePublished": article.data.publishedDate,
  "dateModified": article.data.updatedDate || article.data.publishedDate,
  "author": {
    "@type": "Person",
    "name": authorData.name,
    "jobTitle": authorData.role,
    "url": `https://cryptopulse.news/author/${article.data.author}`
  },
  "publisher": {
    "@type": "NewsMediaOrganization",
    "name": "CryptoPulse",
    "url": "https://cryptopulse.news",
    "logo": {
      "@type": "ImageObject",
      "url": "https://cryptopulse.news/logo.png"
    }
  },
  "articleSection": categoryMeta.name,
  "keywords": article.data.tags.join(', ')
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://cryptopulse.news"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": categoryMeta.name,
      "item": `https://cryptopulse.news/category/${article.data.category}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": article.data.title,
      "item": fullCanonical
    }
  ]
};

// FAQ Schema if present
const faqSchema = article.data.faqs && article.data.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": article.data.faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
} : null;

const schemas = [articleSchema, breadcrumbSchema];
if (faqSchema) schemas.push(faqSchema);
---

<BaseLayout
  title={article.data.metaTitle || article.data.title}
  exactTitle={Boolean(article.data.metaTitle)}
  description={article.data.metaDescription || article.data.excerpt}
  canonicalUrl={fullCanonical}
  ogImage={article.data.featuredImage}
  ogType="article"
  publishedDate={article.data.publishedDate}
  updatedDate={article.data.updatedDate}
  authorName={authorData.name}
  structuredData={schemas}
>
  <!-- Reading Progress Bar -->
  <div id="progress-bar" class="fixed top-0 left-0 h-1 bg-amber-400 z-50 transition-all duration-75" style="width: 0%;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    
    <!-- Top Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 flex-wrap" aria-label="Breadcrumbs">
      <a href="/" class="hover:text-amber-600 transition-colors">Home</a>
      <span>/</span>
      <a href={`/category/${article.data.category}`} class="hover:text-amber-600 transition-colors">
        {categoryMeta.name}
      </a>
      <span>/</span>
      <span class="text-slate-700 truncate max-w-sm">{article.data.title}</span>
    </nav>

    <!-- Standard Financial-Journalism Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Primary Article Content (8 Columns) -->
      <article class="lg:col-span-8 min-w-0">
        
        <!-- Header Zone -->
        <header class="mb-6">
          <div class="flex items-center gap-2.5 mb-3">
            <a
              href={`/category/${article.data.category}`}
              class={`px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider border ${categoryMeta.badgeColor}`}
            >
              {categoryMeta.name}
            </a>
            <span class="text-xs uppercase font-bold text-amber-700 px-2 py-0.5 rounded bg-amber-50 border border-amber-200">
              {article.data.contentType || 'Analysis'}
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl lg:text-4xl font-extrabold text-black tracking-tight leading-[1.2] mb-4">
            {article.data.title}
          </h1>

          <p class="text-base sm:text-lg text-slate-800 font-normal leading-relaxed mb-6">
            {article.data.excerpt}
          </p>

          <!-- Byline & Verification Bar (E-E-A-T Standard) -->
          <div class="flex flex-wrap items-center justify-between gap-4 py-3.5 border-y border-slate-200 text-xs text-slate-500">
            <div class="flex items-center gap-3">
              <a href={`/author/${article.data.author}`} class="shrink-0">
                <img
                  src={authorData.avatar}
                  alt={authorData.name}
                  class="w-10 h-10 rounded-full object-cover border border-amber-400"
                />
              </a>
              <div>
                <div class="flex items-center gap-2">
                  <a href={`/author/${article.data.author}`} class="font-bold text-slate-900 hover:text-amber-600 transition-colors">
                    {authorData.name}
                  </a>
                  {authorData.credentials && (
                    <span class="text-[10px] bg-slate-100 text-amber-700 px-1.5 py-0.5 rounded border border-slate-200">
                      {authorData.credentials}
                    </span>
                  )}
                </div>
                <p class="text-slate-500 text-[11px]">{authorData.role}</p>
              </div>
            </div>

            <div class="flex items-center gap-4 text-[11px]">
              <div>
                <span class="text-slate-500">Published:</span>
                <time datetime={article.data.publishedDate} class="text-slate-700 font-medium ml-1">
                  {pubDateStr}
                </time>
              </div>
              {modDateStr && (
                <div class="hidden sm:block">
                  <span class="text-emerald-600">Updated:</span>
                  <time datetime={article.data.updatedDate} class="text-slate-700 font-medium ml-1">
                    {modDateStr}
                  </time>
                </div>
              )}
              <div>
                <span class="text-slate-500">Read Time:</span>
                <span class="text-slate-700 font-medium ml-1">{article.data.readingTime}</span>
              </div>
            </div>
          </div>
        </header>

        <!-- Featured Editorial Hero Image -->
        <figure class="mb-8">
          <div class="rounded-2xl overflow-hidden border border-slate-200 aspect-[16/9] bg-slate-100 shadow-md">
            <img
              src={article.data.featuredImage}
              alt={article.data.imageAlt}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
          {article.data.imageCaption && (
            <figcaption class="text-[11px] text-slate-500 mt-2 text-center italic">
              {article.data.imageCaption}
            </figcaption>
          )}
        </figure>

        <!-- Executive Key Takeaways / Highlights Callout Box -->
        {article.data.keyHighlights && article.data.keyHighlights.length > 0 && (
          <div class="bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-white border-l-4 border-amber-500 border border-slate-200 rounded-r-2xl p-6 mb-8 shadow-xs">
            <div class="flex items-center gap-2 text-amber-700 font-bold text-xs uppercase tracking-wider mb-3.5">
              <span class="text-base">⚡</span>
              <span class="tracking-widest">Key Takeaways & Executive Summary</span>
            </div>
            <ul class="space-y-2.5 text-[15px] text-slate-800">
              {article.data.keyHighlights.map((highlight) => (
                <li class="flex items-start gap-3">
                  <span class="text-amber-600 font-black mt-1 text-sm">▶</span>
                  <span class="leading-relaxed font-normal">{highlight}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Social Share Bar -->
        <div class="flex items-center justify-between gap-3 p-3.5 bg-white border border-slate-200 rounded-xl mb-8 text-xs shadow-xs">
          <span class="font-semibold text-slate-600">Share this report:</span>
          <div class="flex items-center gap-2">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.data.title)}&url=${encodeURIComponent(fullCanonical)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white rounded-md transition-colors inline-flex items-center gap-1.5"
            >
              <span>𝕏 Post</span>
            </a>
            <a
              href={`https://t.me/share/url?url=${encodeURIComponent(fullCanonical)}&text=${encodeURIComponent(article.data.title)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition-colors inline-flex items-center gap-1.5"
            >
              <span>Telegram</span>
            </a>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(fullCanonical)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 bg-blue-700 hover:bg-blue-800 text-white rounded-md transition-colors inline-flex items-center gap-1.5"
            >
              <span>LinkedIn</span>
            </a>
            <button
              onclick="navigator.clipboard.writeText(window.location.href); alert('Article URL copied to clipboard!');"
              class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-md transition-colors cursor-pointer"
            >
              Copy Link
            </button>
          </div>
        </div>

        <!-- In-depth Article Prose with Custom Standard Styling -->
        <div class="article-prose">
          <slot />
        </div>

        <!-- Verified Sources & Citations -->
        {article.data.sources && article.data.sources.length > 0 && (
          <div class="mt-10 p-5 bg-slate-50 border border-slate-200 rounded-xl text-xs">
            <div class="font-bold text-slate-900 mb-2 flex items-center gap-2">
              <span>📋</span>
              <span>Regulatory Filings & Primary Sources:</span>
            </div>
            <ul class="space-y-1.5 text-slate-600">
              {article.data.sources.map(src => (
                <li>
                  <a href={src.url} target="_blank" rel="noopener noreferrer nofollow" class="text-amber-600 hover:underline">
                    {src.name} ↗
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- FAQ Section with Schema Accordion -->
        {article.data.faqs && article.data.faqs.length > 0 && (
          <section class="mt-12 pt-8 border-t border-slate-200">
            <h2 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
              <span>Frequently Asked Questions</span>
            </h2>
            <div class="space-y-3.5">
              {article.data.faqs.map((faq) => (
                <div class="bg-white border border-slate-200 hover:border-slate-300 rounded-xl p-5 transition-all shadow-xs">
                  <h3 class="text-sm font-bold text-slate-900 mb-2 flex items-start gap-2">
                    <span class="text-amber-600 font-black text-xs mt-0.5">Q:</span>
                    <span>{faq.question}</span>
                  </h3>
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed pl-5 font-normal">
                    {faq.answer}
                  </p>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Article Tag Pills -->
        <div class="mt-8 pt-6 border-t border-slate-200 flex flex-wrap items-center gap-2">
          <span class="text-xs text-slate-500 font-bold uppercase mr-2">Tags:</span>
          {article.data.tags.map((tag) => {
            const tagSlug = tag
              .toLowerCase()
              .trim()
              .replace(/[^\w\s-]/g, '')
              .replace(/[\s_-]+/g, '-')
              .replace(/^-+|-+$/g, '');
            return (
              <a
                href={`/tag/${tagSlug}`}
                class="px-3 py-1.5 bg-white hover:bg-slate-100 border border-slate-200 hover:border-amber-400 rounded-lg text-xs font-medium text-slate-700 hover:text-amber-700 transition-all cursor-pointer inline-flex items-center gap-1.5 group shadow-xs"
              >
                <span class="text-amber-600 font-semibold">#</span>
                <span>{tag}</span>
              </a>
            );
          })}
        </div>

        <!-- Full Author E-E-A-T Bio Box -->
        <div class="mt-10 p-6 bg-white border border-slate-200 rounded-2xl flex flex-col sm:flex-row gap-5 items-start shadow-xs">
          <img
            src={authorData.avatar}
            alt={authorData.name}
            class="w-16 h-16 rounded-full object-cover border-2 border-amber-400 shrink-0"
          />
          <div class="flex-1">
            <div class="flex items-center justify-between mb-1.5">
              <div>
                <h3 class="text-base font-bold text-slate-900">{authorData.name}</h3>
                <p class="text-xs text-amber-700 font-medium">{authorData.role}</p>
              </div>
              <a
                href={`/author/${article.data.author}`}
                class="text-xs text-slate-600 hover:text-slate-950 underline font-medium"
              >
                View Author Dossier →
              </a>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-3">
              {authorData.bio}
            </p>
            {authorData.credentials && (
              <div class="text-[11px] text-slate-500">
                <span class="font-bold text-slate-700">Credentials:</span> {authorData.credentials}
              </div>
            )}
          </div>
        </div>

        <!-- Prev / Next Navigation -->
        <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4 pt-6 border-t border-slate-200">
          {prevArticle ? (
            <a href={`/news/${prevArticle.slug}`} class="p-4 bg-white hover:bg-slate-50 border border-slate-200 rounded-xl group transition-all shadow-xs">
              <span class="text-[10px] uppercase font-bold text-slate-500 block mb-1">← Previous Report</span>
              <span class="text-xs font-bold text-slate-900 group-hover:text-amber-600 line-clamp-2 transition-colors">
                {prevArticle.data.title}
              </span>
            </a>
          ) : <div />}

          {nextArticle ? (
            <a href={`/news/${nextArticle.slug}`} class="p-4 bg-white hover:bg-slate-50 border border-slate-200 rounded-xl group transition-all text-right sm:text-right shadow-xs">
              <span class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Next Report →</span>
              <span class="text-xs font-bold text-slate-900 group-hover:text-amber-600 line-clamp-2 transition-colors">
                {nextArticle.data.title}
              </span>
            </a>
          ) : <div />}
        </div>

      </article>

      <!-- Right Editorial Sidebar (4 Columns) -->
      <aside class="lg:col-span-4 space-y-6">
        
        <!-- Table of Contents Widget -->
        <div class="sticky top-20 space-y-6">
          
          <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-amber-500"></span>
              <span>Table of Contents</span>
            </h3>

            <nav id="toc-nav" class="space-y-1.5 text-xs text-slate-600 max-h-[360px] overflow-y-auto pr-1">
              {headings && headings.filter(h => h.depth === 2 || h.depth === 3).length > 0 ? (
                headings
                  .filter(h => h.depth === 2 || h.depth === 3)
                  .map(h => (
                    <a
                      href={`#${h.slug}`}
                      class:list={[
                        "block hover:text-amber-600 py-1 transition-colors leading-snug",
                        h.depth === 2 ? "font-semibold text-slate-800" : "pl-3 text-slate-500 text-[11px]"
                      ]}
                    >
                      {h.text}
                    </a>
                  ))
              ) : (
                <div class="text-slate-400 italic text-xs">Standard report outline</div>
              )}
            </nav>
          </div>

          <!-- Related Market Intelligence -->
          <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-4 flex items-center gap-2">
              <span>📰</span>
              <span>Related Policy & Markets</span>
            </h3>

            <div class="space-y-4">
              {relatedArticles.slice(0, 4).map((rel) => (
                <a href={`/news/${rel.slug}`} class="group block border-b border-slate-100 pb-3 last:border-0 last:pb-0">
                  <span class="text-[10px] uppercase font-bold text-amber-600 block mb-1">
                    {rel.data.category}
                  </span>
                  <h4 class="text-xs font-bold text-slate-900 group-hover:text-amber-600 line-clamp-2 transition-colors">
                    {rel.data.title}
                  </h4>
                </a>
              ))}
            </div>
          </div>

          <!-- Sponsored Placement -->
          <AdPlacement format="sidebar" label="Partner Placement" />
        </div>

      </aside>

    </div>

  </div>

  <script is:inline>
    // Reading Progress Indicator
    window.addEventListener('scroll', () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById('progress-bar');
      if (bar) bar.style.width = scrolled + '%';
    });
  </script>
</BaseLayout>